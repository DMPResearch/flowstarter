---
import { getCollection, render } from 'astro:content';
import { readPublicConfig } from '../lib/public-config.mjs';

// Fail compilation before publishing a site with missing tenant configuration.
readPublicConfig({
  PUBLIC_SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
  PUBLIC_SUPABASE_PUBLISHABLE_KEY: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
  PUBLIC_TENANT_ID: import.meta.env.PUBLIC_TENANT_ID,
});
const entries = await getCollection('business');
if (entries.length !== 1) throw new Error('A tenant build requires exactly one business entry');
const business = entries[0]!;
const { Content } = await render(business);
const { name, description, city, email, design } = business.data;
---
<!doctype html>
<html lang="en" data-palette={design.palette} data-density={design.density}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{name} | {city}</title>
  </head>
  <body>
    <main>
      <header><h1>{name}</h1><p>{description}</p><p>{city} · <a href={`mailto:${email}`}>{email}</a></p></header>
      <Content />
    </main>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; font-family: "Helvetica Neue", sans-serif; color: #451a03; background: #faf8f5; --accent: #92400e; --space: 24px; }
  :root[data-palette="graphite"] { color-scheme: dark; color: #fafafa; background: #18181b; --accent: #d8b4fe; }
  :root[data-density="compact"] { --space: 16px; }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.6; }
  main { max-width: 760px; margin: 0 auto; padding: 32px 24px; }
  header { border-bottom: 1px solid currentColor; padding-bottom: var(--space); margin-bottom: 32px; }
  h1 { font-size: 2rem; margin: 0; }
  h2 { font-size: 1.35rem; }
  a { color: var(--accent); }
  form { display: grid; gap: 12px; margin-block: var(--space); }
  label { display: grid; gap: 4px; }
  input, textarea, button { font: inherit; color: inherit; border: 1px solid currentColor; border-radius: 4px; padding: 8px 12px; background: transparent; }
  textarea { resize: vertical; }
  button { justify-self: start; cursor: pointer; }
  button:disabled, fieldset:disabled { opacity: .6; cursor: default; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 12px; }
  [hidden] { display: none !important; }
</style>
