{
  "name": "@flowstarter/flow-design-system",
  "version": "0.1.0",
  "description": "Flowstarter Design System - Shared UI components and tokens",
  "private": true,
  "sideEffects": ["**/*.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./clerk": "./src/clerk/index.ts",
    "./clerk-account.css": "./src/styles/clerk-account.css",
    "./styles": "./src/styles/index.css",
    "./styles/landing.css": "./src/styles/landing.css",
    "./tokens": "./src/tokens/index.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowstarter/platform-config": "workspace:*",
    "@radix-ui/react-slot": "^1.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@clerk/themes": "^2.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@clerk/themes": "^2.4.41",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "flowstarter",
    "design-system",
    "ui",
    "components",
    "react"
  ]
}
