# /etc/flowstarter/editor.env — mode 600, owned by root, never in git.
#
# Copy this file to the box, fill it in, and recreate the container
# (`docker rm -f` + `up -d`, NOT `docker restart`, which does not re-read
# --env-file). See docs/operations/operator-editor.md.

# ── Routing ────────────────────────────────────────────────────────────────
# The domain client sites answer on. The router parses `<slug>.<domain>` out
# of the forwarded Host exactly as the editor's own clerkGate does; if these
# two disagree, routing and auth disagree and a request lands on the wrong
# workspace. Same value as PLATFORM_DOMAIN on the app slot.
EDITOR_PUBLIC_DOMAIN=flowstarter.net

# ── The control plane ──────────────────────────────────────────────────────
# Shared with flowstarter-main's EDITOR_CONTROL_SECRET. At least 32 characters
# — both sides refuse a shorter one rather than sending it. Generate with:
#   openssl rand -hex 32
# This secret authorises materialising and reading back a client's whole site,
# so it is the same class of credential as DEPLOY_AGENT_SHARED_SECRET.
EDITOR_CONTROL_SECRET=

# ── Auth ───────────────────────────────────────────────────────────────────
# The editor runs its own Clerk membership check per workspace process. Same
# instance as the app, so the one-minute sign-in ticket the admin page mints
# is one this side will accept.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Workspace lookup ───────────────────────────────────────────────────────
# The editor's own Clerk gate (`/api/clerk/me`, `/api/clerk/auto-pair`)
# resolves a signed-in browser's identity — role, tier, allowed workspace
# ids — straight against Supabase, independent of the router's materialise
# call (which flowstarter-main already authorised). Without these two, every
# request answers 503 `{"authenticated":false,"configError":true}` and the
# editor never gets past "Verifying your session". Same values as the app
# slot's `NEXT_PUBLIC_SUPABASE_URL` / `SUPABASE_SERVICE_ROLE_KEY` — on this
# box, the local Supabase CLI stack. Verified against a real deploy on
# fs-sites-01, 2026-09-15.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── The coding agent ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# REQUIRED. The container runs as root, and "Full access" runtime mode makes
# the Claude Agent SDK pass --dangerously-skip-permissions, which Claude Code
# refuses under root — the turn dies with "Claude Code process exited with
# code 1 / Runtime error". Each workspace is isolated in its own process with
# its own cwd and state dir, so this genuinely is a sandbox. Without it,
# default-permission threads work and full-access ones fail, which is the
# confusing half-broken state this line exists to prevent.
IS_SANDBOX=1

# ── Caps (optional; the compose file has defaults) ─────────────────────────
# EDITOR_MAX_CHILDREN=8
# EDITOR_IDLE_TTL_MS=900000
# EDITOR_MEM_LIMIT=3g
# EDITOR_PIDS_LIMIT=2048
# EDITOR_HOST_PORT=3773
