# /etc/flowstarter/build-worker-staging.env — mode 600, root-owned.
#
# The staging build worker's environment. Copy this file, fill it in, and
# bring the container up with `worker-stack.sh up`. Every value is validated
# once at boot by apps/build-worker/src/config.ts; a missing or malformed one
# stops the process with a message naming the variable, rather than half-running
# a client's paid build.
#
# Values marked "same as staging.env" MUST be copied by name from
# /etc/flowstarter/staging.env. Two of them are not merely a convenience:
# FLOWSTARTER_BUILD_WORKER_SECRET is the shared bearer both directions of this
# conversation are signed with, and CAL_BASE_URL decides whether a client's
# self-hosted booking link survives the build at all (see below).

# ── What environment this is ────────────────────────────────────────────────
# The single most important line. `staging` forces docker isolation for every
# generated build (isolation.ts refuses `native` here), refuses
# FLOWSTARTER_BUILD_SKIP_VALIDATION outright, and picks the staging defaults
# for the platform domain. NODE_ENV is set by the compose file, and cannot name
# staging on its own — a staging slot runs NODE_ENV=production like a real
# production build.
FLOWSTARTER_ENV=staging

# ── Dispatch auth ───────────────────────────────────────────────────────────
# Must be byte-identical to FLOWSTARTER_BUILD_WORKER_SECRET in
# /etc/flowstarter/staging.env: the app signs its dispatch with it, and the
# worker signs its deploy callback and its policy scan back with the same one.
# At least 32 characters. `openssl rand -hex 32`.
FLOWSTARTER_BUILD_WORKER_SECRET=replace-with-at-least-32-random-characters
FLOWSTARTER_BUILD_WORKER_PORT=8787
# Loopback, and `worker-stack.sh check` refuses anything else. The container
# runs with `network_mode: host`, so 0.0.0.0 here is a plain open port on this
# box with nothing but the Hetzner Cloud Firewall in front of it.
FLOWSTARTER_BUILD_WORKER_HOST=127.0.0.1

# ── The ledger ──────────────────────────────────────────────────────────────
# The Supabase CLI stack on this host, same as staging.env. The job ledger,
# the artifact tables and site_versions have no grant but the service role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321   # same as staging.env
SUPABASE_SERVICE_ROLE_KEY=                        # same as staging.env

# ── Publish mode ────────────────────────────────────────────────────────────
# `local`, not `github`, and this is a decision rather than a shortcut.
#
# `github` publishes by opening a draft PR against a sites repository. That is
# a review gate, not a deploy: nothing reaches the client's host, no
# site_versions row is published and the deploy-agent is never called. Staging
# exists to rehearse the chain that ends with a client seeing their site, and
# OPERATOR_EDIT_BUILD / CHANGE_REQUEST_BUILD both end in a deploy. `local`
# packages the built output, keeps the tarball on this worker where the
# deploy-agent can fetch it over loopback, and asks flowstarter-main to run the
# ordinary deploySite path — same tarball format, same agent endpoint, same
# `deployments` row. Nothing in the deploy chain is simulated.
FLOWSTARTER_BUILD_MODE=local
# Where the worker posts its deploy callback and its acceptable-use scan. The
# app slot runs with host networking, so this box's loopback is its loopback.
# There is no default and there must not be: a silent fallback to port 3000
# killed two builds against a port nothing was listening on.
FLOWSTARTER_MAIN_URL=http://127.0.0.1:3000
# Where the deploy-agent fetches the packaged tarball from. This worker, over
# loopback. The route is unauthenticated (the agent holds no bearer for us) and
# safe only because the file name carries 128 bits of CSPRNG.
FLOWSTARTER_BUILD_ARTIFACT_BASE_URL=http://127.0.0.1:8787
# The gate that reads the built site must be run, not skipped: this worker
# publishes sites a client will see. `local` mode defaults this to false
# (a laptop with no app running), which is the wrong default here.
FLOWSTARTER_POLICY_SCAN_REQUIRED=true

# ── Where the platform answers ──────────────────────────────────────────────
# FLOWSTARTER_MAIN_URL above is loopback, which is correct for the callback and
# wrong for anything baked INTO a client's site. Two things read the public
# origin instead: the contact-form endpoint the worker writes into every site
# it builds, and the Content-Security-Policy that site is gated against. Set
# both of these so neither is derived from a guess.
PLATFORM_DOMAIN=                                  # same as staging.env
FLOWSTARTER_PUBLIC_APP_ORIGIN=https://staging.flowstarter.dev

# ── Self-hosted Cal.com ─────────────────────────────────────────────────────
# Load-bearing, and silent when wrong. The host in this URL is what tells
# normalizeCalTarget that a workspace's booking link on the platform's own
# Cal.com is a real booking link. Leave it unset and the allow list falls back
# to `cal.com` only, the booking page is dropped from the build, and the client
# ships without the calendar they were emailed a link to. Must equal the app
# slot's value.
CAL_BASE_URL=                                     # same as staging.env

# ── Worker state, at a path the HOST daemon can resolve ─────────────────────
# All four live under the one bind mount the compose file makes at an identical
# absolute path on both sides. `worktrees` in particular is handed to the host
# Docker daemon as a bind source when the validation container starts, so a
# path that existed only inside the container would mount nothing.
FLOWSTARTER_REPOSITORY_ROOT=/srv/flowstarter/build-worker/repository
FLOWSTARTER_WORKTREES_ROOT=/srv/flowstarter/build-worker/worktrees
FLOWSTARTER_BUILD_ARTIFACTS_ROOT=/srv/flowstarter/build-worker/artifacts
# The worker-owned copy of a build's output that every gate and the publisher
# read. On disk rather than the default /tmp: /tmp in this container is a 1g
# tmpfs, and a site with photographs is not obliged to fit in it.
FLOWSTARTER_BUILD_OUTPUT_EXPORT_ROOT=/srv/flowstarter/build-worker/output

# ── The coding session ──────────────────────────────────────────────────────
# Required at boot even though the two job kinds this slot sees most
# (OPERATOR_EDIT_BUILD, SITE_REBUILD) never call a model: the worker refuses to
# start without credentials it might need for a FULL_SITE_BUILD. Copy
# ANTHROPIC_API_KEY from /etc/flowstarter/anthropic.env, or set
# OPENROUTER_API_KEY with PI_PROVIDER=openrouter instead.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_API_KEY=
PI_THINKING_LEVEL=medium

# ── Isolation for generated code ────────────────────────────────────────────
# The default in staging, written out because it is the rule the whole
# deployment turns on. `native` is refused here.
FLOWSTARTER_BUILD_ISOLATION=docker
# The prepared image, built on this host from
# apps/build-worker/docker/validation-runtime.Dockerfile. It is what makes
# `--network=none` possible for the build step: corepack would otherwise have
# to fetch pnpm for EVERY command, and a generated site's build would get the
# install step's outbound egress.
FLOWSTARTER_BUILD_VALIDATE_DOCKER_IMAGE=flowstarter/build-validation:node22-pnpm10
FLOWSTARTER_BUILD_VALIDATE_DOCKER_PNPM_BAKED=true
# The container runs as this worker's own uid:gid so build output in the bind
# mount stays readable by the process that reads it back. Stated explicitly so
# that a future change to the image's user is a visible edit and not a silent
# one; uid 0 is refused either way.
FLOWSTARTER_BUILD_VALIDATE_DOCKER_USER=1000:1000

# ── Queue, leases and retries ───────────────────────────────────────────────
# All defaults; written out so an operator reading this file knows what the
# worker will do without reading its source. One build at a time, three
# attempts, a sweep of the ledger every minute so a lost dispatch nudge (a
# restart, a deploy, a brief a client finished at 2am) still gets picked up.
FLOWSTARTER_BUILD_CONCURRENCY=1
FLOWSTARTER_BUILD_QUEUE_LIMIT=32
FLOWSTARTER_BUILD_MAX_ATTEMPTS=3
FLOWSTARTER_BUILD_POLL_INTERVAL_MS=60000
FLOWSTARTER_BUILD_LEASE_TTL_MS=120000
FLOWSTARTER_BUILD_LEASE_HEARTBEAT_MS=30000
