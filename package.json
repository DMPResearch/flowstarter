{
  "name": "flowstarter",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "mprocs",
    "dev:bootstrap": "bash scripts/dev-bootstrap.sh",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:main": "pnpm nx run flowstarter-main:dev --output-style=stream",
    "docker:dev:main:up": "docker compose -f docker-compose.flowstarter-main-dev.yml up -d --build",
    "docker:dev:main:down": "docker compose -f docker-compose.flowstarter-main-dev.yml down",
    "docker:dev:main:logs": "docker compose -f docker-compose.flowstarter-main-dev.yml logs -f flowstarter-main-dev",
    "docker:dev:main:restart": "docker compose -f docker-compose.flowstarter-main-dev.yml restart flowstarter-main-dev",
    "build:all": "pnpm nx run-many -t build --output-style=stream",
    "lint:all": "pnpm nx run-many -t lint --output-style=stream --fix",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:setup:dry": "tsx scripts/stripe-setup.ts --dry-run",
    "anthropic:invite-users": "tsx scripts/anthropic-invite-users.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "dev:deploy-agent": "bash scripts/dev-deploy-agent.sh",
    "dev:build-worker": "pnpm --dir apps/build-worker dev",
    "dev:build-worker:local": "pnpm --dir apps/build-worker dev:local",
    "seed:local-hosting": "node scripts/seed-local-hosting.mjs",
    "verify:local-deploy": "tsx scripts/verify-local-deploy-chain.ts",
    "dev:editor": "bash scripts/dev-editor.sh",
    "dev:editor:hmr": "bash scripts/dev-editor-hmr.sh",
    "dev:editor:plain": "pnpm --dir apps/flowstarter-editor dev",
    "dev:editor:full": "pnpm --dir apps/flowstarter-editor dev:full",
    "dev:editor:server": "pnpm --dir apps/flowstarter-editor dev:server",
    "dev:editor:web": "pnpm --dir apps/flowstarter-editor dev:web",
    "build:editor:web": "pnpm --dir apps/flowstarter-editor build:web",
    "supabase:login": "pnpm dlx supabase login",
    "db:link": "pnpm dlx supabase link --project-ref \"${SUPABASE_PROJECT_REF:?set SUPABASE_PROJECT_REF to the project you mean}\"",
    "db:start": "pnpm dlx supabase start",
    "db:stop": "pnpm dlx supabase stop",
    "db:pull": "pnpm dlx supabase db pull",
    "db:push": "pnpm dlx supabase db push",
    "db:reset": "pnpm dlx supabase db reset",
    "db:rollback": "pnpm dlx supabase db rollback",
    "db:env": "node scripts/supabase-local-env.mjs",
    "dev:supabase": "pnpm run db:start && pnpm run db:env",
    "staging:start": "pnpm --filter flowstarter-main build && pm2 startOrReload ecosystem.config.cjs && pm2 list",
    "staging:stop": "pm2 stop ecosystem.config.cjs",
    "staging:restart": "pm2 reload ecosystem.config.cjs",
    "staging:delete": "pm2 delete ecosystem.config.cjs",
    "staging:status": "pm2 list",
    "staging:monit": "pm2 monit",
    "staging:logs": "pm2 logs",
    "staging:logs:main": "pm2 logs flowstarter-main",
    "staging:save": "pm2 save",
    "staging:flush": "pm2 flush",
    "ci:lint": "pnpm --dir apps/flowstarter-main lint || true",
    "ci:typecheck": "pnpm nx run-many -t build --projects=flow-design-system --output-style=stream-without-prefixes && pnpm nx run flowstarter-main:typecheck",
    "ci:test": "pnpm nx run flowstarter-main:test",
    "ci:quality-gate": "pnpm run ci:lint && pnpm run ci:typecheck && pnpm run ci:test",
    "ci:smoke:platform": "pnpm exec playwright test --config playwright.config.ts",
    "ci:smoke": "pnpm run ci:smoke:platform",
    "prepare": "husky"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.22",
    "@nx/eslint": "^22.7.9",
    "@nx/eslint-plugin": "22.7.9",
    "@nx/js": "^22.7.9",
    "@nx/next": "^22.7.9",
    "@nx/node": "^22.7.9",
    "@nx/react": "^22.7.9",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "concurrently": "^7.6.0",
    "dotenv": "^17.3.0",
    "husky": "^9.1.7",
    "mprocs": "^0.8.3",
    "nx": "22.7.9",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "stripe": "^20.4.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.2",
      "jsondiffpatch": "^0.7.6",
      "@effect/platform": "0.96.1",
      "tar": "^7.5.22",
      "undici": "^6.24.0",
      "protobufjs": "^7.5.6",
      "fast-uri": "^3.1.7",
      "svgo": "^4.1.0",
      "minimatch": "^9.0.7",
      "basic-ftp": "^5.3.1",
      "devalue": "^5.8.1",
      "fast-xml-parser": "^5.5.6",
      "handlebars": "^4.7.9",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "defu": "^6.1.5",
      "js-cookie": "^3.0.7",
      "express-rate-limit": "^8.2.2",
      "@hono/node-server": "^1.19.10",
      "hono": "^4.12.4",
      "axios": "^1.18.0",
      "postcss": "^8.5.25",
      "dompurify": "^3.3.1",
      "ws": "^8.21.0",
      "serialize-javascript": "^7.0.3",
      "tmp": "^0.2.6",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "shell-quote": "^1.9.0",
      "form-data": "^4.0.6",
      "ip-address": "^10.4.0",
      "browserslist": "^4.28.7",
      "@ai-sdk/provider-utils": "^3.0.28",
      "@humanfs/node": "0.16.8",
      "qs": "^6.16.0",
      "vite": "^8.0.13",
      "cookie": "^1.1.1",
      "@vitest/browser": "^4.1.10",
      "@vitest/mocker": "^4.1.11",
      "happy-dom": "^20.8.9",
      "immutable": "^5.1.8",
      "http-proxy-middleware": "^3.0.7",
      "webpack-dev-server": "^5.2.6",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "uuid": "^13.0.1",
      "toml": "^4.2.0",
      "postcss-selector-parser": "^7.1.3",
      "picomatch": "^4.0.4",
      "adm-zip": "^0.6.0",
      "sigstore": "^4.1.1",
      "pacote": "^21.5.1",
      "stream-json": "^3.5.0",
      "seroval": "^1.5.3",
      "rollup": "^4.59.0",
      "launch-editor": "^2.14.1",
      "koa": "^3.1.2",
      "bn.js": "^5.2.3",
      "baseline-browser-mapping": "^2.11.0",
      "@tootallnate/once": "^2.0.1",
      "@opentelemetry/core": "^2.8.0",
      "@opentelemetry/exporter-prometheus": "^0.217.0",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "@opentelemetry/sdk-node": "^0.217.0",
      "@octokit/plugin-paginate-rest": "^9.2.2",
      "@octokit/request": "^8.4.1",
      "@octokit/request-error": "^5.1.1",
      "@babel/core": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@anthropic-ai/sdk": "^0.91.1",
      "@clerk/clerk-react": "^5.61.6",
      "@clerk/localizations>@clerk/shared": "^4.8.3",
      "@clerk/themes>@clerk/shared": "^3.47.5",
      "uploadthing>effect": "^3.21.2",
      "@uploadthing/shared>effect": "^3.21.2",
      "@grpc/grpc-js": "^1.14.4",
      "body-parser@2": "^2.3.0",
      "yaml": "^2.8.3",
      "valibot": "^1.4.2",
      "websocket-driver": "^0.7.5",
      "fflate": "^0.8.3",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "path-to-regexp@0": "^0.1.13",
      "colord": "^2.9.4",
      "nx>brace-expansion": "^5.0.9",
      "esbuild": "^0.28.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    },
    "onlyBuiltDependencies": [
      "node-pty",
      "bufferutil",
      "utf-8-validate",
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "@swc/core",
      "msgpackr-extract"
    ]
  }
}
