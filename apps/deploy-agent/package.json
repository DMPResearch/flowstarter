{
  "name": "@flowstarter/deploy-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Per-server agent that receives Caddy host deploys from flowstarter-main",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:linux": "bun build --compile --minify --target=bun-linux-x64 --outfile dist/deploy-agent-linux-x64 src/index.ts",
    "build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 --outfile dist/deploy-agent-linux-arm64 src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.7.3"
  }
}
