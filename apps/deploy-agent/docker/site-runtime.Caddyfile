{
	admin off
	auto_https off
	persist_config off
}

# TLS terminates once at the host's front Caddy, which reverse-proxies here
# over loopback — see caddy-snippet.ts's `ServeTarget: proxy` output.
:8080 {
	root * /srv
	encode zstd gzip
	header {
		-Server
	}
	# The site's security headers — Content-Security-Policy, nosniff, referrer
	# and permissions policy — are written in here by the deploy agent
	# (`site-csp.ts`), because the policy depends on what this particular
	# artifact contains: the hash of each managed inline script, and the
	# origins its pages frame. The agent refuses to build a site image from a
	# Caddyfile that has lost this line, so a template edit cannot quietly
	# ship a site with no policy.
	# flowstarter:security-headers
	@assets path *.js *.mjs *.css *.woff *.woff2 *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.ico
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path *.js *.mjs *.css *.woff *.woff2 *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.ico
	header @pages Cache-Control "no-cache"
	try_files {path} {path}/ /index.html
	file_server
}
