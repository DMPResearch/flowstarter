# ================================
# SUPABASE CONFIGURATION
# ================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_PROJECT_REF=your-supabase-project-ref-here

# ================================
# CLERK AUTHENTICATION
# ================================
# Get these from: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here

# Clerk URLs (customize these for your app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Supabase JWT Template Name (default: 'supabase')
CLERK_SUPABASE_TEMPLATE=supabase

# ================================
# AI SERVICES
# ================================

# OpenRouter API Key (recommended - unified access to 200+ AI models)
# Get from: https://openrouter.ai/keys
# Provides access to Claude, GPT-4, DeepSeek, Llama, and many more
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional preview-role overrides. Keep extended reasoning off for a faster
# bounded content-edit pass with Sonnet. Other roles keep their own settings.
# PI_PREVIEW_MODEL=anthropic/claude-sonnet-4.6
# PI_PREVIEW_THINKING_LEVEL=off

# OpenAI API Key (required for DALL-E logo generation and content moderation)
# Get from: https://platform.openai.com/api-keys
# Only used for specialized tasks (image generation, moderation)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AI Audit Encryption Key (for secure AI event logging)
# Generate a random 32-byte hex string
AI_AUDIT_ENC_KEY=your-random-32-byte-hex-string-here

# ================================
# GODADDY DOMAIN API (Optional)
# ================================
# Get from: https://developer.godaddy.com/
# See docs/GODADDY_API_SETUP.md for setup instructions

GODADDY_API_KEY=your-godaddy-api-key-here
GODADDY_API_SECRET=your-godaddy-api-secret-here
GODADDY_USE_PRODUCTION=false  # Set to 'true' for production environment

# ================================
# UPLOADTHING (File Uploads)
# ================================
# Get from: https://uploadthing.com/dashboard
# See docs/UPLOADTHING_SETUP.md for setup instructions

UPLOADTHING_SECRET=your-uploadthing-secret-here
UPLOADTHING_APP_ID=your-uploadthing-app-id-here

# ================================
# UPSTASH REDIS (Rate Limiting)
# ================================
# Get from: https://console.upstash.com/
# Optional - if not set, rate limiting will be disabled

UPSTASH_REDIS_REST_URL=your-upstash-redis-url-here
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# ================================
# DAYTONA (Code Workspaces)
# ================================
# Get from: https://www.daytona.io/
# Optional - if not set, Daytona features will be disabled

DAYTONA_API_KEY=your-daytona-api-key-here

# ================================
# ANALYTICS & INTEGRATIONS
# ================================

# Google Analytics Measurement ID for Flowstarter app analytics
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google OAuth Client Credentials (for user Google Analytics integration)
# Get from: https://console.cloud.google.com/apis/credentials
# See docs/GOOGLE_OAUTH_SETUP.md for detailed setup instructions
# Required for users to connect their Google Analytics accounts
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# [DEPRECATED - Use OAuth instead] Google Analytics Service Account (optional)
# Only needed if you want to use service account instead of OAuth
# Get from: https://console.cloud.google.com/
# 1. Enable Google Analytics Data API
# 2. Create service account with Analytics Viewer role
# 3. Download JSON key and paste entire content as single line
GOOGLE_ANALYTICS_CREDENTIALS=

# ================================
# SITE CONFIGURATION
# ================================

# Your site URL (used for redirects, CORS, CSP connect-src in dev, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public app base (invite links, etc.) — also used for dev redirect allowlists when set
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# LAN / iPad dev: set to your Mac's LAN URL so Clerk + middleware trust redirects and CORS.
# Example (same values in apps/flowstarter-editor/server/.env if you use the editor from a tablet):
# NEXT_PUBLIC_SITE_URL=http://192.168.1.5:3000
# NEXT_PUBLIC_EDITOR_URL=http://192.168.1.5:5733
# NEXT_PUBLIC_EXTRA_REDIRECT_ORIGINS=http://192.168.1.5:3000,http://192.168.1.5:5733,http://192.168.1.5:5773
# Also add those http origins under Clerk Dashboard → Domains → Allowed redirect origins.

# Vercel URL (automatically set by Vercel, no need to set manually)
NEXT_PUBLIC_VERCEL_URL=

# ================================
# EDITOR INTEGRATION
# ================================

# Editor app URL (for handoff redirects). Local flowstarter-editor web dev server defaults to port 5733.
NEXT_PUBLIC_EDITOR_URL=http://localhost:5733

# Handoff secret for secure cross-app communication (generate with: openssl rand -base64 32)
# Can also use TOKEN_ENCRYPTION_KEY if already set
HANDOFF_SECRET=

# ================================
# STRIPE PAYMENTS
# ================================
# Get from: https://dashboard.stripe.com/apikeys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Signed dispatch from Stripe webhook to the isolated full-site build worker.
# Use a private HTTPS origin and independent random secrets (32+ characters).
# The same secret authorizes the worker's callback to
# POST /api/internal/build/deploy, so both sides must hold exactly this value.
# Locally: FLOWSTARTER_BUILD_WORKER_URL=http://127.0.0.1:8787 (plain http is
# accepted for loopback only, and only outside production).
FLOWSTARTER_BUILD_WORKER_URL=https://flowstarter-build-worker.internal
FLOWSTARTER_BUILD_WORKER_SECRET=replace-with-at-least-32-random-characters

# ================================
# LOCAL HOSTING (dev only)
# ================================
# Shared secret for the deploy-agent mprocs starts; matched by the
# hosting_servers row `node scripts/seed-local-hosting.mjs` writes.
DEPLOY_AGENT_SHARED_SECRET=dev-secret
# Where the local deploy-agent serves what it extracted, by path:
# http://localhost:8788/{slug}/. Unset in production, where sites are reached
# by hostname over TLS.
FLOWSTARTER_LOCAL_SITE_BASE_URL=http://localhost:8788

# Headless Pi worker configuration. Keep these server-side only.
PI_PROVIDER=openai
PI_MODEL=your-approved-model-id
PI_API_KEY=your-provider-api-key

# Opt-in LangGraph HITL intake (phrasing + multi-field extract). Default is the
# deterministic scripted conversation. Rules still decide gates; the model only
# phrases and extracts.
# NEXT_PUBLIC_FLOWSTARTER_INTAKE_GRAPH=true

FLOWSTARTER_MCP_URL=https://flowstarter-template-library.internal/mcp
FLOWSTARTER_MCP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
FLOWSTARTER_REPOSITORY_ROOT=/srv/flowstarter/repository
FLOWSTARTER_WORKTREES_ROOT=/srv/flowstarter/worktrees

# ================================
# RESEND EMAIL
# ================================
# Get from: https://resend.com/api-keys

RESEND_API_KEY=your-resend-api-key-here

# ================================
# LINEAR INTEGRATION
# ================================
# Get from: https://linear.app/settings/api

LINEAR_API_KEY=your-linear-api-key-here

# ================================
# CALENDLY INTEGRATION
# ================================
# Get from: https://developer.calendly.com/

CALENDLY_CLIENT_ID=your-calendly-client-id-here
CALENDLY_CLIENT_SECRET=your-calendly-client-secret-here

# ================================
# CLOUDFLARE R2 STORAGE
# ================================
# Get from: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens

R2_ACCOUNT_ID=your-r2-account-id-here
R2_ACCESS_KEY_ID=your-r2-access-key-id-here
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key-here

# ================================
# WEBHOOKS & TOKENS
# ================================

# Clerk Webhook Secret (for user sync webhooks)
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret-here

# Invite Token Encryption Key (generate with: openssl rand -base64 32)
INVITE_TOKEN_SECRET=your-invite-token-secret-here

# ================================
# FEATURE FLAGS
# ================================

# Node Environment (automatically set)
NODE_ENV=development

# Skip T3 Env validation (set to "1" in Docker builds or CI where env vars aren't available)
# SKIP_ENV_VALIDATION=1
