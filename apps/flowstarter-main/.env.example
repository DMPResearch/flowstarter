# ================================
# SUPABASE CONFIGURATION
# ================================
# Local development uses the Supabase CLI stack (127.0.0.1:54321), not a
# hosted project. It's the default: run `pnpm db:start` then `pnpm db:env`
# and NEXT_PUBLIC_SUPABASE_URL / the two keys below are written for you into
# a gitignored `apps/flowstarter-main/.env.development.local`, which wins
# over whatever the same names hold here or in `.env.local`. You do not need
# to set the four Supabase values in this file for local dev.
#
# `src/lib/supabase-target.ts` enforces this: development (and staging)
# refuse to start against a hosted Supabase URL. The override,
# FLOWSTARTER_ALLOW_REMOTE_SUPABASE=1, exists for the rare case that
# genuinely needs a hosted project from a dev/staging process; set it only
# when you mean it.
#
# FLOWSTARTER_ENV names which environment this process is (development,
# test, staging, production). It defaults from NODE_ENV, so it only needs
# setting explicitly for staging, which otherwise runs with
# NODE_ENV=production like a real production build.
#
# Real production values (the hosted project) live only in
# /etc/flowstarter/prod.env on the Hetzner host, and in Depot's secret store
# for the build-time NEXT_PUBLIC_* values, never in a file in this repo.
# FLOWSTARTER_ENV=development
# FLOWSTARTER_ALLOW_REMOTE_SUPABASE=1

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_PROJECT_REF=your-supabase-project-ref-here

# ================================
# CLERK AUTHENTICATION
# ================================
# Get these from: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here

# Clerk URLs (customize these for your app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Supabase JWT Template Name (default: 'supabase')
CLERK_SUPABASE_TEMPLATE=supabase

# ================================
# AI SERVICES
# ================================

# OpenRouter API Key (recommended - unified access to 200+ AI models)
# Get from: https://openrouter.ai/keys
# Provides access to Claude, GPT-4, DeepSeek, Llama, and many more
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional preview-role overrides. Keep extended reasoning off for a faster
# bounded content-edit pass with Sonnet. Other roles keep their own settings.
# PI_PREVIEW_MODEL=anthropic/claude-sonnet-4.6
# PI_PREVIEW_THINKING_LEVEL=off

# OpenAI API Key (required for DALL-E logo generation and content moderation)
# Get from: https://platform.openai.com/api-keys
# Only used for specialized tasks (image generation, moderation)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AI Audit Encryption Key (for secure AI event logging)
# Generate a random 32-byte hex string
AI_AUDIT_ENC_KEY=your-random-32-byte-hex-string-here

# ================================
# GODADDY DOMAIN API (Optional)
# ================================
# Get from: https://developer.godaddy.com/
# See docs/GODADDY_API_SETUP.md for setup instructions

GODADDY_API_KEY=your-godaddy-api-key-here
GODADDY_API_SECRET=your-godaddy-api-secret-here
GODADDY_USE_PRODUCTION=false  # Set to 'true' for production environment

# ================================
# UPLOADTHING (File Uploads)
# ================================
# Get from: https://uploadthing.com/dashboard
# See docs/UPLOADTHING_SETUP.md for setup instructions

UPLOADTHING_SECRET=your-uploadthing-secret-here
UPLOADTHING_APP_ID=your-uploadthing-app-id-here

# ================================
# ARCJET (Bot detection, shield, and rate limiting)
# ================================
# Get from: https://app.arcjet.com/
#
# ARCJET_KEY alone is sufficient in production: it covers both the global
# middleware protection (shield, bot detection on browser-facing routes) and
# every per-route rate limit in docs/security/rate-limits.md. Upstash below
# becomes optional once this is set — it is a second, independent way to get
# a shared (multi-instance) rate-limit tier, not a requirement alongside
# Arcjet.
#
# Production refuses to boot on the process-local (single-instance,
# in-memory) rate-limit tier unless ARCJET_KEY or the Upstash pair below is
# set, or FLOWSTARTER_ALLOW_LOCAL_RATE_LIMIT=1 is set as an explicit
# override. See docs/security/rate-limits.md for the full backend order and
# the browser/machine/none Arcjet policy per route.

ARCJET_KEY=your-arcjet-key-here

# ================================
# UPSTASH REDIS (Rate Limiting)
# ================================
# Get from: https://console.upstash.com/
# Optional - a second, independent way (alongside or instead of Arcjet above)
# to get a shared rate-limit tier. If neither this nor ARCJET_KEY is set,
# rate limiting falls back to a single process's own in-memory count, which
# production refuses to run on by default (see the ARCJET section above).

UPSTASH_REDIS_REST_URL=your-upstash-redis-url-here
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# ================================
# DAYTONA (Code Workspaces)
# ================================
# Get from: https://www.daytona.io/
# Optional - if not set, Daytona features will be disabled

DAYTONA_API_KEY=your-daytona-api-key-here

# ================================
# ANALYTICS & INTEGRATIONS
# ================================

# Google OAuth Client Credentials (for user Google Analytics integration)
# Get from: https://console.cloud.google.com/apis/credentials
# See docs/GOOGLE_OAUTH_SETUP.md for detailed setup instructions
# Required for users to connect their Google Analytics accounts
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# [DEPRECATED - Use OAuth instead] Google Analytics Service Account (optional)
# Only needed if you want to use service account instead of OAuth
# Get from: https://console.cloud.google.com/
# 1. Enable Google Analytics Data API
# 2. Create service account with Analytics Viewer role
# 3. Download JSON key and paste entire content as single line
GOOGLE_ANALYTICS_CREDENTIALS=

# ================================
# SITE CONFIGURATION
# ================================

# Your site URL (used for redirects, CORS, CSP connect-src in dev, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public app base (invite links, etc.) — also used for dev redirect allowlists when set
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# LAN / iPad dev: set to your Mac's LAN URL so Clerk + middleware trust redirects and CORS.
# Example (same values in apps/flowstarter-editor/server/.env if you use the editor from a tablet):
# NEXT_PUBLIC_SITE_URL=http://192.168.1.5:3000
# NEXT_PUBLIC_EDITOR_URL=http://192.168.1.5:5733
# NEXT_PUBLIC_EXTRA_REDIRECT_ORIGINS=http://192.168.1.5:3000,http://192.168.1.5:5733,http://192.168.1.5:5773
# Also add those http origins under Clerk Dashboard → Domains → Allowed redirect origins.

# Vercel URL (automatically set by Vercel, no need to set manually)
NEXT_PUBLIC_VERCEL_URL=

# ================================
# PUBLIC APP / CALLBACK ORIGIN
# ================================
# Where the app itself is publicly served, and where a third party's servers
# (Cal.com's webhook delivery; Stripe is separate) must be able to reach it.
# See packages/platform-config/src/public-origin.ts.
#
# `publicAppOrigin()` is the ONE rule for the first question, and every call
# site that used to answer it a different way now reads it: Stripe's success
# and cancel URLs (the deposit, the claim and the change-request checkouts),
# the client dashboard link every notification email carries, the unlock
# link, the sitemap and robots.txt (next-sitemap.config.mjs), and the OAuth
# redirect_uri the LinkedIn/Instagram portrait connect sends (see
# FLOWSTARTER_PORTRAIT_STATE_SECRET below — there is no separate redirect-base
# var for it anymore).
#
# Two different questions from "which domain does a client site live under"
# (PLATFORM_DOMAIN / NEXT_PUBLIC_PLATFORM_DOMAIN): those agree only in
# production, where the app is the domain's apex. In development the app
# lives on NEXT_PUBLIC_SITE_URL or http://localhost:{PORT}; on the shared
# staging box it lives at staging.{domain}, not the bare apex, which serves
# nothing. Getting this wrong is why a client site built from a dev or
# staging stack used to post its contact-form enquiries into a 404, and why
# the Cal.com booking page used to print a LAN address nobody but the laptop
# it was built on can reach.
#
# Leave both unset almost everywhere: production and staging derive the right
# value from FLOWSTARTER_ENV/PLATFORM_DOMAIN already. Set FLOWSTARTER_PUBLIC_APP_ORIGIN
# only for a slot that answers somewhere other than its environment's default
# subdomain (a PR staging box, e.g. https://pr-7.staging.flowstarter.dev).
# Set FLOWSTARTER_PUBLIC_CALLBACK_ORIGIN only in development, and only when a
# third party (Cal.com) has to reach a tunnel in front of your laptop rather
# than NEXT_PUBLIC_SITE_URL / localhost directly.
# FLOWSTARTER_PUBLIC_APP_ORIGIN=https://pr-7.staging.flowstarter.dev
# FLOWSTARTER_PUBLIC_CALLBACK_ORIGIN=https://my-tunnel.trycloudflare.com

# ================================
# EDITOR INTEGRATION
# ================================

# Editor app URL (for handoff redirects). Local flowstarter-editor web dev server defaults to port 5733.
NEXT_PUBLIC_EDITOR_URL=http://localhost:5733

# Handoff secret for secure cross-app communication (generate with: openssl rand -base64 32)
# Can also use TOKEN_ENCRYPTION_KEY if already set
HANDOFF_SECRET=

# ================================
# AUTH TRANSFER DESTINATIONS
# ================================
# The only origins a Clerk sign-in ticket may be sent to. A ticket is a bearer
# credential, so this is an allow-list and NOT the general redirect rule --
# that one trusts every generated client site at {slug}.{platformDomain}.
# See docs/security/auth-transfer-policy.md.
#
# Leave all three empty in production: they default to https://{domain},
# https://code.{domain} + https://editor.{domain}, and https://library.{domain}.
# Set them when a surface answers somewhere else (a staging slot, a LAN dev
# machine, a self-hosted editor). An http:// value is accepted only when the
# process resolves to development.
#
# AUTH_TRANSFER_APP_ORIGIN=http://localhost:3000       # else NEXT_PUBLIC_SITE_URL
# AUTH_TRANSFER_EDITOR_ORIGIN=http://localhost:5733    # else NEXT_PUBLIC_EDITOR_URL
# AUTH_TRANSFER_LIBRARY_ORIGIN=http://localhost:3000

# ================================
# STRIPE PAYMENTS
# ================================
# Get from: https://dashboard.stripe.com/apikeys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Signed dispatch from Stripe webhook to the isolated full-site build worker.
# Use a private HTTPS origin and independent random secrets (32+ characters).
# The same secret authorizes the worker's callback to
# POST /api/internal/build/deploy, so both sides must hold exactly this value.
# Locally: FLOWSTARTER_BUILD_WORKER_URL=http://127.0.0.1:8787 (plain http is
# accepted for loopback only, and only outside production).
FLOWSTARTER_BUILD_WORKER_URL=https://flowstarter-build-worker.internal
FLOWSTARTER_BUILD_WORKER_SECRET=replace-with-at-least-32-random-characters

# ================================
# LOCAL HOSTING (dev only)
# ================================
# Shared secret for the deploy-agent mprocs starts; matched by the
# hosting_servers row `node scripts/seed-local-hosting.mjs` writes.
DEPLOY_AGENT_SHARED_SECRET=dev-secret
# Where the local deploy-agent serves what it extracted, by path:
# http://localhost:8788/{slug}/. Unset in production, where sites are reached
# by hostname over TLS.
FLOWSTARTER_LOCAL_SITE_BASE_URL=http://localhost:8788

# Headless Pi worker configuration. Keep these server-side only.
PI_PROVIDER=openai
PI_MODEL=your-approved-model-id
PI_API_KEY=your-provider-api-key

# Opt-in LangGraph HITL intake (phrasing + multi-field extract). Default is the
# deterministic scripted conversation. Rules still decide gates; the model only
# phrases and extracts.
# NEXT_PUBLIC_FLOWSTARTER_INTAKE_GRAPH=true

FLOWSTARTER_MCP_URL=https://flowstarter-template-library.internal/mcp
FLOWSTARTER_MCP_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
FLOWSTARTER_REPOSITORY_ROOT=/srv/flowstarter/repository
FLOWSTARTER_WORKTREES_ROOT=/srv/flowstarter/worktrees

# ================================
# RESEND EMAIL
# ================================
# Get from: https://resend.com/api-keys

RESEND_API_KEY=your-resend-api-key-here

# ================================
# OPERATOR ALERTS
# ================================
# See docs/operations/alerts.md and src/lib/ops/alerts.ts. Unset:
# alerts are still decided and counted in the ops_alerts table, but nothing
# is emailed.
OPERATOR_ALERT_EMAIL=ops@example.com
# Optional overrides for how long a repeat of the same alert stays silent.
# Each has a documented default in src/lib/ops/alerts.ts; leave unset to use it.
# OPS_ALERT_BUILD_JOB_FAILED_DEDUPE_MINUTES=60
# OPS_ALERT_CLIENT_EMAIL_FAILED_DEDUPE_MINUTES=240
# OPS_ALERT_HEALTH_CHECK_FAILED_DEDUPE_MINUTES=30

# ================================
# LINEAR INTEGRATION
# ================================
# Get from: https://linear.app/settings/api

LINEAR_API_KEY=your-linear-api-key-here

# ================================
# CALENDLY INTEGRATION
# ================================
# Get from: https://developer.calendly.com/

CALENDLY_CLIENT_ID=your-calendly-client-id-here
CALENDLY_CLIENT_SECRET=your-calendly-client-secret-here

# ================================
# PORTRAIT FROM SOCIAL
# ================================
# See docs/portrait-sources.md. A client's portrait photograph, sourced from
# their own social pages. Create the LinkedIn app on linkedin.com/developers
# ("Sign In with LinkedIn using OpenID Connect") and the Meta app on
# developers.facebook.com ("Instagram API with Instagram Login"). Unset: the
# connect buttons render disabled, saying "this connection is not switched on
# yet", and the three automatic sources still run.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional tuning. Each has a documented default in
# src/lib/flowstarter/portrait-config.ts; leave unset to use it.
# FLOWSTARTER_PORTRAIT_MIN_EDGE=400
# FLOWSTARTER_PORTRAIT_AVATAR_MIN_EDGE=96
# FLOWSTARTER_PORTRAIT_PROVIDER_TIMEOUT_MS=6000
# FLOWSTARTER_PORTRAIT_STATE_TTL_MS=600000
# FLOWSTARTER_PORTRAIT_MAX_BYTES=4194304
# The three automatic sources: the GitHub avatar, the client's own page, and
# Instagram's public OpenGraph picture. They run inside the brand-signals
# fetch while a visitor waits, so the timeout is the one to reach for first.
# FLOWSTARTER_PORTRAIT_GITHUB_EDGE=460
# FLOWSTARTER_PORTRAIT_AUTO_TIMEOUT_MS=4000
# FLOWSTARTER_PORTRAIT_MAX_HTML_BYTES=1500000
# FLOWSTARTER_PORTRAIT_MAX_IMG_TAGS=200
# FLOWSTARTER_PORTRAIT_HEADING_WINDOW=2000
# Signs the connect state. Falls back to the provider's own client secret.
# FLOWSTARTER_PORTRAIT_STATE_SECRET=
# The callback URL the provider has on file, byte for byte, is now
# FLOWSTARTER_PUBLIC_APP_ORIGIN (see "PUBLIC ORIGIN" above) plus
# /api/connect/<provider>/callback — the same override every other public
# origin in the app reads, rather than a redirect-base var of its own. Pin it
# on a pr-N slot for the same reason: its own ephemeral hostname is not
# registered with LinkedIn or Instagram, the staging base is.
# See src/lib/flowstarter/portrait-connect.ts.

# ================================
# SIGMA CLASSIFIER MODEL (acceptable-use / scope gate)
# ================================
# @flowstarter/sigma-flowstarter (PR #160) classifies discovery-funnel briefs
# locally, with a pinned multilingual-e5-small ONNX encoder
# (packages/sigma-core/config/encoder.json) — no network call at inference,
# ever (`allowRemoteModels=false`). That file has to be fetched once, out of
# band, before src/instrumentation.ts's startup warm-up
# (src/lib/sigma/warm.ts) can find it:
#
#   pnpm --filter @flowstarter/sigma-core fetch-model
#
# One-off, not part of `pnpm install`: it downloads ~135 MB and every file is
# sha256-verified against encoder.json, so it is safe to re-run — a file
# already present with the right hash is left alone. Writes to
# SIGMA_MODEL_CACHE_DIR below, or `~/.cache/flowstarter/sigma-core` if unset.
# Without it, warm-up logs a warning and every acceptable-use/scope check
# fails open to human review; nothing else in the app breaks.
#
# deploy/hetzner-staging/Dockerfile runs the equivalent of this command at
# image build time (see its `sigma-model` stage) and bakes the cache into the
# image, so staging/production never need this set. Set it here only to move
# the cache off the default `~/.cache` path.
# SIGMA_MODEL_CACHE_DIR=~/.cache/flowstarter/sigma-core

# ================================
# CLOUDFLARE R2 STORAGE
# ================================
# Get from: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens

R2_ACCOUNT_ID=your-r2-account-id-here
R2_ACCESS_KEY_ID=your-r2-access-key-id-here
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key-here

# ================================
# WEBHOOKS & TOKENS
# ================================

# Clerk Webhook Secret (for user sync webhooks)
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret-here

# Invite Token Encryption Key (generate with: openssl rand -base64 32)
INVITE_TOKEN_SECRET=your-invite-token-secret-here

# ================================
# LEGAL: WHO OPERATES FLOWSTARTER
# ================================

# The six values the terms and privacy pages print. See
# src/lib/legal/company.ts. All six or none: until every one of them is set,
# both pages render "Operator identity pending registration" instead of
# naming a company, a country or a court, and the draft notice stays up on
# all three legal pages. Left EMPTY here on purpose. There is no entity yet
# and a placeholder would be the exact failure this module exists to stop.
FLOWSTARTER_LEGAL_ENTITY_NAME=
FLOWSTARTER_LEGAL_REGISTRATION_NUMBER=
FLOWSTARTER_LEGAL_VAT_NUMBER=
FLOWSTARTER_LEGAL_ADDRESS=
FLOWSTARTER_LEGAL_JURISDICTION=
FLOWSTARTER_LEGAL_COURT=

# ================================
# REFUND GUARANTEE
# ================================

# The published promise, read by the operator's refund action AND by the
# landing hero and terms page that state it. See
# src/lib/billing/refund-policy.ts. Unset, both default to what has been
# published since launch: 50% of the setup fee, within 30 days of launch.
# Changing either here changes the promise on the site and the amount the
# refund button is allowed to send. Set the NEXT_PUBLIC_ twin as well: the
# refund action reads the server name, the landing copy is bundled for the
# browser and can only read the public one, and moving one without the other
# would change what we pay without changing what we promised.
# FLOWSTARTER_REFUND_WINDOW_DAYS=30
# FLOWSTARTER_REFUND_PERCENT=50
# NEXT_PUBLIC_FLOWSTARTER_REFUND_WINDOW_DAYS=30
# NEXT_PUBLIC_FLOWSTARTER_REFUND_PERCENT=50

# ================================
# FEATURE FLAGS
# ================================

# Node Environment (automatically set)
NODE_ENV=development

# Skip T3 Env validation (set to "1" in Docker builds or CI where env vars aren't available)
# SKIP_ENV_VALIDATION=1
