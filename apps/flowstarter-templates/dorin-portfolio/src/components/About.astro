---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import SectionHeading from './design-system/SectionHeading.astro';
import VennStatement from './design-system/VennStatement.astro';

const { about } = siteLabels;
---

<SectionBlock id="about" className="about" tone="dark">
  <div class="about__stage" data-about-stage>
    <div class="about__inner container" data-about-sticky>
      <SectionHeading
        className="about__header"
        label={about.sectionLabel}
        title={about.title}
        align="center"
        maxWidth="700px"
        labelColor="var(--text-on-dark)"
      />
      <VennStatement circles={about.circles} />
      <p class="about__text">{about.text}</p>
    </div>
  </div>
</SectionBlock>

<style>
  :global(.about) {
    overflow: clip;
  }

  .about__stage {
    min-height: 360vh;
    position: relative;
  }

  .about__inner {
    position: sticky;
    top: 88px;
    min-height: calc(100vh - 88px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  :global(.about__header) {
    margin-bottom: 56px;
  }

  .about__text {
    font-size: var(--fs-body);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .about__stage {
      min-height: auto;
    }

    .about__inner {
      position: static;
      min-height: auto;
      display: block;
    }

    :global(.about__header) {
      margin-bottom: 40px;
    }
  }
</style>

