---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Book a Discovery Call — Portfolio">
  <Header ctaDisabled={true} />
  <main class="book-page">
    <div class="book-page__inner container">
      <div class="book-page__copy">
        <h1 class="book-page__title">Book a Discovery Call</h1>
        <p class="book-page__description">
          Let's spend 30 minutes understanding where your product is today and where it needs to go.
          No pitch, just a clear conversation about your challenges and how I can help.
        </p>
      </div>
      <div class="book-page__calendar">
        <!--
          The trusted integration step replaces this block with the workspace's
          own booking embed. It only runs when a validated booking link exists,
          and with no link this page is never scaffolded at all, so what stands
          here is a fallback rather than a promise: it sends the visitor to a
          person instead of to a calendar that belongs to nobody.
        -->
        <p class="book-page__fallback">
          Prefer to write first? <a href="/contact">Send a message</a> and you will
          get a reply from a person, usually the same day.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .book-page {
    padding-top: 64px;
  }

  .book-page__inner {
    padding-top: 80px;
    padding-bottom: 100px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    max-width: 860px;
    margin: 0 auto;
  }

  .book-page__copy {
    display: grid;
    gap: 20px;
    text-align: center;
    justify-items: center;
  }

  .book-page__title {
    color: var(--bg-dark);
    line-height: 1.05;
  }

  .book-page__description {
    line-height: 1.45;
    color: var(--bg-dark);
    padding: 0 40px;
  }

  .book-page__calendar {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-base);
  }

  .book-page__fallback {
    margin: 0;
    padding: 40px;
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .book-page__inner {
      padding-top: 48px;
      padding-bottom: 64px;
      gap: 40px;
    }
  }
</style>
