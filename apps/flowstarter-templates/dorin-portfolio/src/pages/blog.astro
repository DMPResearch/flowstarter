---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import AnimatedWordTitle from '../components/shared/AnimatedWordTitle.astro';
import { frontmatter as siteLabels } from '../content/site-labels.md';

const { articles } = (siteLabels as any).blogPage ?? {};
---

<Layout title="Blog — Portfolio">
  <Header activeIndex={4} />
  <main class="blog-page">

    <section class="blog-hero container">
      <AnimatedWordTitle
        as="h1"
        autoplay={true}
        centered={true}
        className="blog-hero__title"
        lines={[
          { text: 'THOUGHTS ON', accent: 'DESIGN,' },
          { text: 'PRODUCT &', accent: 'CRAFT' },
        ]}
      />
      <p class="blog-hero__sub">Short reads on UX, product thinking, and the decisions that shape better digital experiences.</p>
    </section>

    <section class="blog-grid container">
      {(articles ?? []).map((article: any, index: number) => (
        <article
          class="blog-card"
          data-blog-reveal
          style={`--reveal-delay: ${index * 80}ms`}
        >
          <a href={article.href} class="blog-card__image-link">
            {article.imageSrc
              ? <img src={article.imageSrc} alt={article.imageAlt} loading="lazy" class="blog-card__image" />
              : <div class="blog-card__image-fallback" style={`background: ${article.color ?? 'var(--surface-field)'}`}></div>
            }
          </a>
          <div class="blog-card__body">
            <span class="blog-card__category">{article.category}</span>
            <h2 class="blog-card__title">
              <a href={article.href} class="blog-card__title-link">{article.title}</a>
            </h2>
            <p class="blog-card__excerpt">{article.excerpt}</p>
            <a href={article.href} class="blog-card__read-more">
              Read article
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </section>

  </main>
  <CTASection />
  <Footer />
</Layout>

<style>
  .blog-page {
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Hero ── */
  .blog-hero {
    padding-top: 80px;
    padding-bottom: 80px;
    display: grid;
    gap: 24px;
    justify-items: center;
    text-align: center;
  }

  :global(.blog-hero__title) {
    font-family: var(--font-title);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: var(--fw-headline);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .blog-hero__sub {
    max-width: 42rem;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    line-height: 1.55;
    color: var(--text-muted);
    opacity: 0;
    transform: translateY(14px);
    animation: blog-sub-enter 600ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 800ms;
  }

  @keyframes blog-sub-enter {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Grid ── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 40px;
    padding-bottom: 96px;
  }

  /* ── Card ── */
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .blog-card__image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin-bottom: 24px;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms ease;
  }

  .blog-card__image-fallback {
    width: 100%;
    height: 100%;
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.04);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .blog-card__category {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
  }

  .blog-card__title {
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    color: var(--bg-dark);
    margin: 0;
  }

  .blog-card__title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
  }

  .blog-card__title-link:hover {
    text-decoration-color: var(--bg-dark);
  }

  .blog-card__excerpt {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bg-dark);
    text-decoration: none;
    transition: gap var(--transition);
  }

  .blog-card__read-more:hover {
    gap: 10px;
  }

  /* ── Reveal ── */
  :global([data-blog-reveal].is-observing:not(.is-visible)) {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(6px);
  }

  :global([data-blog-reveal].is-observing) {
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  :global([data-blog-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0);
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-hero__sub { opacity: 1; transform: none; animation: none; }
    :global([data-blog-reveal].is-observing) { opacity: 1; transform: none; filter: none; transition: none; }
  }

  @media (max-width: 768px) {
    .blog-hero { padding-top: 56px; padding-bottom: 48px; }
    .blog-grid { grid-template-columns: 1fr; gap: 40px; padding-bottom: 64px; }
  }
</style>

