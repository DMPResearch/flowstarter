---
interface Props {
  title: string;
  category: string;
  color: string;
  imageSrc?: string;
  imageScale?: number;
  href?: string;
  className?: string;
}

const { title, category, color, imageSrc, imageScale = 1, href = '#', className = '' } = Astro.props;
---

<a href={href} class={`ds-case-card ${className}`.trim()}>
  <div class="ds-case-card__image" style={imageSrc ? undefined : `background-color: ${color};`}>
    {imageSrc ? (
      <img
        class="ds-case-card__media"
        src={imageSrc}
        alt={title}
        loading="lazy"
        style={`transform: scale(${imageScale});`}
      />
    ) : (
      // No screenshot for this project — never fill the tile with the
      // template's own stock or abstract art standing in for real work.
      // A typographic tile (the project's own name and category) is honest
      // about there being nothing to show yet.
      <div class="ds-case-card__typographic" aria-hidden="true">
        <span class="ds-case-card__typographic-title">{title}</span>
        <span class="ds-case-card__typographic-category">{category}</span>
      </div>
    )}
  </div>
  <div class="ds-case-card__info">
    <div class="ds-case-card__title-row">
      <h3 class="ds-case-card__title">{title}</h3>
      <span class="ds-case-card__headline-arrow" aria-hidden="true">&#8599;</span>
    </div>
    <span class="ds-case-card__category">{category}</span>
  </div>
</a>

<style>
  .ds-case-card {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition);
  }

  .ds-case-card:hover {
    transform: translateY(-4px);
  }

  .ds-case-card__image {
    aspect-ratio: 161 / 140;
    position: relative;
    overflow: hidden;
  }

  .ds-case-card__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform-origin: center;
  }

  .ds-case-card__typographic {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 24px;
  }

  .ds-case-card__typographic-title {
    font-size: var(--fs-h4, 1.25rem);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    color: var(--text-on-dark, currentColor);
  }

  .ds-case-card__typographic-category {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark, currentColor);
    opacity: 0.72;
  }

  .ds-case-card__info {
    padding: 16px 4px;
  }

  .ds-case-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .ds-case-card__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    margin-bottom: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--transition);
  }

  .ds-case-card:hover .ds-case-card__title {
    text-decoration-color: var(--bg-dark);
  }

  .ds-case-card__headline-arrow {
    font-size: 1.75rem;
    color: var(--bg-dark);
    line-height: 1;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform var(--transition);
  }

  .ds-case-card:hover .ds-case-card__headline-arrow {
    transform: translate(2px, -2px);
  }

  .ds-case-card__category {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
