---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import StatItem from './design-system/StatItem.astro';

const stats = (siteLabels as any).stats ?? {};
---

<SectionBlock className="stats" tone="dark" padding="compact">
  <div class="stats__shell container">
    <div class="stats__head">
      <span class="section-label">By the numbers</span>
      <h2 class="stats__title">A decade of deliberate work</h2>
    </div>
    <div class="stats__inner" data-stats-section>
      {(stats.items ?? []).map((stat) => (
        <StatItem number={stat.number} label={stat.label} />
      ))}
    </div>
  </div>
</SectionBlock>

<style>
  :global(.ds-section--dark.stats) {
    position: relative;
    overflow: clip;
  }

  :global(.ds-section--dark.stats)::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 12% 0%, rgba(255, 59, 31, 0.12), transparent 46%);
    pointer-events: none;
  }

  :global(.stats.ds-section--compact) {
    padding: 100px 0;
  }

  .stats__shell {
    position: relative;
    display: grid;
    gap: 56px;
  }

  .stats__head {
    display: grid;
    gap: 16px;
    max-width: 32ch;
  }

  .stats__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 340;
    color: var(--text-on-dark);
    line-height: 1.02;
  }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: var(--border-color);
    border: 1px solid var(--border-color);
  }

  .stats__inner :global(.ds-stat-item) {
    background: var(--bg-dark);
    padding: 36px 24px;
    gap: 10px;
    align-items: flex-start;
    text-align: left;
  }

  .stats__inner :global(.ds-stat-item__number) {
    color: var(--text-on-dark);
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .stats__inner :global(.ds-stat-item__label) {
    color: var(--text-nav);
    font-size: var(--fs-small);
  }

  @media (max-width: 1024px) {
    .stats__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats__inner :global(.ds-stat-item) {
      padding: 28px 18px;
    }
  }
</style>

