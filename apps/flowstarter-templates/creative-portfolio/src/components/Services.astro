---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import SectionHeading from './design-system/SectionHeading.astro';
import ServiceCard from './design-system/ServiceCard.astro';
import ActionButton from './design-system/ActionButton.astro';

const serviceIcons = [
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
];

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;

const servicesLabels = (siteLabels as any).services ?? {};
const services = (servicesLabels.items ?? []).map((item, index) => ({
  ...item,
  icon: serviceIcons[index],
}));
---

<SectionBlock id="services" className="services">
  <div class="services__stage" data-services-stage>
    <div class="services__inner container" data-services-sticky>
      <div class="services__heading-row">
        <SectionHeading
          label={servicesLabels.sectionLabel}
          titleLines={servicesLabels.sectionTitleLines}
          titleColor="var(--bg-dark)"
        />
        {showCta && (
          <ActionButton
            href="/services"
            label="See all services"
            variant="outline"
            className="services__cta ds-action-button--outline-dark"
          />
        )}
      </div>
      <div class="services__grid">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
          />
        ))}
      </div>
    </div>
  </div>
</SectionBlock>

<style>
  .services__grid :global(h4.ds-service-card__title) {
    font-size: var(--fs-h4);
  }

  :global(.services) {
    overflow: clip;
  }

  .services__stage {
    position: relative;
  }

  .services__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 20px 0;
  }

  /* Cards reveal on load (scroll choreography removed) */
  .services__grid :global(.ds-service-card) {
    --service-reveal-progress: 1;
    animation: service-card-rise 640ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  .services__grid :global(.ds-service-card:nth-child(1)) { animation-delay: 60ms; }
  .services__grid :global(.ds-service-card:nth-child(2)) { animation-delay: 130ms; }
  .services__grid :global(.ds-service-card:nth-child(3)) { animation-delay: 200ms; }
  .services__grid :global(.ds-service-card:nth-child(4)) { animation-delay: 270ms; }
  .services__grid :global(.ds-service-card:nth-child(5)) { animation-delay: 340ms; }
  .services__grid :global(.ds-service-card:nth-child(6)) { animation-delay: 410ms; }

  @keyframes service-card-rise {
    from { opacity: 0; transform: translateY(60px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .services__grid :global(.ds-service-card) {
      animation: none;
    }
  }

  .services__heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .services__inner {
      gap: 36px;
    }

    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services__inner {
      display: block;
    }

    .services__grid {
      margin-top: 32px;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

