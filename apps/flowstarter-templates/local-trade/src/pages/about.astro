---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutArticlesSection from '../components/about/AboutArticlesSection.astro';
import AboutBackgroundSection from '../components/about/AboutBackgroundSection.astro';
import AboutFreeTimeSection from '../components/about/AboutFreeTimeSection.astro';
import AboutHeroSection from '../components/about/AboutHeroSection.astro';
import AboutIntroSection from '../components/about/AboutIntroSection.astro';
import AboutJourneySection from '../components/about/AboutJourneySection.astro';
import CTASection from '../components/CTASection.astro';
import { getAboutPageData } from '../lib/site-data';

const aboutPage = getAboutPageData();
import { pageTitle } from '../lib/site-data';
---

<Layout title={pageTitle('About Us')}>
  <Header activeIndex={2} />
  <main class="about-page">
    <AboutHeroSection heroLines={aboutPage.heroLines} />
    <AboutIntroSection intro={aboutPage.intro} />
    <AboutFreeTimeSection freeTime={aboutPage.freeTime} />
    <AboutBackgroundSection background={aboutPage.backgroundExperience} />
    <AboutJourneySection journey={aboutPage.journey} />
    <AboutArticlesSection
      title={aboutPage.latestArticles.title}
      buttonLabel={aboutPage.latestArticles.buttonLabel}
      buttonHref={aboutPage.latestArticles.buttonHref}
      articles={aboutPage.latestArticles.articles}
    />
  </main>
  <CTASection />
  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    gap: var(--about-page-gap, 120px);
    /* The zigzag reveal parks parts sideways before they animate in;
       without this the right-shifted ones widen the page on phones and the
       whole site scrolls sideways. */
    overflow-x: clip;
  }

  .about-page :global([data-about-reveal]) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .about-page :global([data-about-reveal].is-observing:not(.is-visible)) {
    opacity: 0;
    transform: translate3d(0, 48px, 0) scale(0.985);
    filter: blur(10px);
  }

  .about-page :global([data-about-reveal].is-observing) {
    transition:
      opacity 820ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 820ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 820ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--about-reveal-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  .about-page :global([data-about-reveal].is-visible) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .about-page :global([data-zigzag-part]) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .about-page :global([data-zigzag-part='left']) {
    --zigzag-shift: -88px;
  }

  .about-page :global([data-zigzag-part='right']) {
    --zigzag-shift: 88px;
  }

  .about-page :global([data-zigzag-section].is-observing:not(.is-visible) [data-zigzag-part]) {
    opacity: 0;
    transform: translate3d(var(--zigzag-shift, 0), 56px, 0) scale(0.97);
    filter: blur(12px);
  }

  .about-page :global([data-zigzag-section].is-observing [data-zigzag-part]) {
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, filter;
  }

  .about-page :global([data-zigzag-section].is-observing [data-zigzag-part='right']) {
    transition-delay: 160ms;
  }

  .about-page :global([data-zigzag-section].is-visible [data-zigzag-part]) {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: none;
  }

  @media (max-width: 768px) {
    .about-page {
      --about-page-gap: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-page :global([data-about-reveal].is-observing),
    .about-page :global([data-zigzag-part]) {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

