---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import SectionHeading from './design-system/SectionHeading.astro';
import ServiceCard from './design-system/ServiceCard.astro';
import ActionButton from './design-system/ActionButton.astro';

const serviceIcons = [
  // Fitted kitchens — cabinet
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1.5"/><line x1="3" y1="11" x2="21" y2="11"/><line x1="9" y1="6.5" x2="9" y2="7.5"/><line x1="15" y1="14.5" x2="15" y2="15.5"/></svg>`,
  // Staircase
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h4v-4h4v-4h4V9h4V5"/><path d="M3 21V5"/></svg>`,
  // Doors & windows
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1"/><line x1="12" y1="3" x2="12" y2="21"/><circle cx="9.5" cy="12" r="0.6" fill="currentColor"/></svg>`,
  // Bespoke furniture — wardrobe
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="11" x2="9.5" y2="11"/><line x1="14.5" y1="11" x2="15" y2="11"/></svg>`,
  // General carpentry — saw
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l11 11"/><path d="M3 7l3 0 0 3"/><path d="M14 18l4 4 3-3-4-4"/><path d="M3 7l9-2 2 2-2 9"/></svg>`,
  // Repairs & restoration — tools
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6 3 3 6-6a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/></svg>`,
];

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;

const { services: servicesLabels } = siteLabels;
const services = servicesLabels.items.map((item, index) => ({
  ...item,
  icon: serviceIcons[index % serviceIcons.length],
}));
---

<SectionBlock id="services" className="services" tone="dark">
  <div class="services__inner container">
    <div class="services__heading-row" data-services-reveal>
      <SectionHeading
        label={servicesLabels.sectionLabel}
        titleLines={servicesLabels.sectionTitleLines}
        titleColor="var(--text-on-dark)"
        labelColor="var(--brand-primary)"
      />
      {showCta && (
        <ActionButton
          href="/services"
          label="See all our services"
          variant="outline"
          className="services__cta ds-action-button--outline-light"
        />
      )}
    </div>
    <div class="services__grid">
      {services.map((service, index) => (
        <div data-services-reveal style={`--reveal-delay: ${80 + index * 70}ms`}>
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
          />
        </div>
      ))}
    </div>
  </div>
</SectionBlock>

<style>
  :global(.services) {
    overflow: clip;
  }

  .services__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .services__grid :global(h4.ds-service-card__title) {
    font-size: var(--fs-h4);
  }

  .services__heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Service cards use --service-reveal-progress for their entrance.
     Keep them visible by default; the wrapper reveal drives a soft rise. */
  .services__grid :global(.ds-service-card) {
    --service-reveal-progress: 1;
  }

  :global([data-services-reveal]) {
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 720ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  :global([data-services-reveal].is-observing:not(.is-visible)) {
    opacity: 0;
    transform: translateY(44px);
    filter: blur(8px);
  }

  :global([data-services-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  @media (max-width: 1024px) {
    .services__inner {
      gap: 36px;
    }

    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services__grid {
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-services-reveal].is-observing) {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

