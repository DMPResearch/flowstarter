---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import StatItem from './design-system/StatItem.astro';

const { stats } = siteLabels;
---

<SectionBlock className="stats" tone="light" padding="compact">
  <div class="stats__inner container" data-stats-section>
    {stats.items.map((stat) => (
      <StatItem number={stat.number} label={stat.label} />
    ))}
  </div>
</SectionBlock>

<style>
  :global(.ds-section--light.stats) {
    background: var(--accent);
    margin-bottom: 5rem;
  }

  :global(.stats.ds-section--compact) {
    padding: 80px 0;
  }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 72px;
  }

  @media (max-width: 768px) {
    .stats__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }
</style>

