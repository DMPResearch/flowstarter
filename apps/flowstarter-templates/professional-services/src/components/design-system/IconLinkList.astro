---
import { sanitizeInlineSvg } from '../../lib/sanitize-html';

interface IconLinkItem {
  href: string;
  ariaLabel: string;
  icon: string;
}

interface Props {
  items: IconLinkItem[];
  className?: string;
}

const { items, className = '' } = Astro.props;
---

<div class={`ds-icon-link-list ${className}`.trim()}>
  {items.map((item) => (
    <a href={item.href} aria-label={item.ariaLabel}>
      <span set:html={sanitizeInlineSvg(item.icon)}></span>
    </a>
  ))}
</div>

<style>
  .ds-icon-link-list {
    display: flex;
    gap: 16px;
  }

  .ds-icon-link-list a {
    color: var(--text-secondary);
    transition: color var(--transition);
    line-height: 0;
  }

  .ds-icon-link-list a:hover {
    color: var(--text-primary);
  }

  .ds-icon-link-list span :global(svg) {
    display: block;
  }
</style>
