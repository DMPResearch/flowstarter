---
import type { JourneyItem } from '../../lib/site-data';

interface Props {
  journey: {
    title: string;
    intro: string;
    items: JourneyItem[];
  };
}

const { journey } = Astro.props;
const stageSteps = Math.max(journey.items.length, 1);
---

<section
  class="about-journey-section container"
  style={`--journey-steps: ${stageSteps}; --journey-columns: ${stageSteps};`}
>
  <div class="about-journey-section__desktop" data-journey-section>
    <div class="about-journey-section__stage" data-journey-stage>
      <div class="about-journey-section__sticky" data-journey-sticky>
        <div class="about-journey-section__intro">
          <h2 class="about-journey-section__title">{journey.title}</h2>
          <p class="about-journey-section__intro-text">{journey.intro}</p>
        </div>

        <div class="about-journey-section__timeline-shell">
          <ol class="about-journey-section__timeline" aria-label="Career timeline">
            {journey.items.map((item, index) => (
              <li
                class={`about-journey-section__timeline-item ${index === 0 ? 'is-active' : ''}`}
                data-journey-step
              >
                <button
                  type="button"
                  class={`about-journey-section__timeline-button ${index === 0 ? 'is-active' : ''}`}
                  data-journey-control
                >
                  <h4 class="about-journey-section__timeline-year">{item.year}</h4>
                  <span class="about-journey-section__timeline-dot" aria-hidden="true"></span>
                </button>
              </li>
            ))}
          </ol>
        </div>

        <div class="about-journey-section__panel">
          {journey.items.map((item, index) => (
            <article
              class={`about-journey-section__card ${index === 0 ? 'is-active' : ''}`}
              data-journey-card
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <p class="about-journey-section__card-description">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="about-journey-section__mobile">
    <div class="about-journey-section__intro">
      <h2 class="about-journey-section__title">{journey.title}</h2>
      <p class="about-journey-section__intro-text">{journey.intro}</p>
    </div>

    <div class="about-journey-section__mobile-list">
      {journey.items.map((item) => (
        <article class="about-journey-section__card about-journey-section__card--static">
          <p class="about-journey-section__card-description">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about-journey-section {
    --journey-timeline-year-size: var(--fs-h3);
    --journey-timeline-gap: 0.5rem;
    --journey-timeline-dot-size: 14px;
    --journey-gap-intro-to-timeline: 3rem;
    --journey-gap-timeline-to-panel: 5rem;
    --journey-scroll-step: 13rem;
    display: grid;
    gap: 0;
    width: 100%;
  }

  .about-journey-section__desktop {
    display: block;
    width: 100%;
  }

  .about-journey-section__stage {
    width: 100%;
  }

  .about-journey-section__sticky {
    position: sticky;
    top: 64px;
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    width: 100%;
  }

  .about-journey-section__intro {
    display: grid;
    gap: 20px;
    width: 100%;
    max-width: none;
  }

  .about-journey-section__title {
    text-transform: uppercase;
    color: var(--bg-dark);
    line-height: 1;
  }

  .about-journey-section__intro-text {
    width: 100%;
    max-width: 31.25rem;
    color: var(--bg-dark);
    line-height: 1.45;
  }

  .about-journey-section__timeline-shell {
    position: relative;
    margin-top: var(--journey-gap-intro-to-timeline);
    width: 100%;
  }

  .about-journey-section__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--journey-columns), minmax(0, 1fr));
    gap: 0;
    align-items: start;
    width: 100%;
  }

  .about-journey-section__timeline-item {
    position: relative;
    min-width: 0;
  }

  .about-journey-section__timeline-item:not(:last-child)::before,
  .about-journey-section__timeline-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    right: -50%;
    z-index: 0;
  }

  .about-journey-section__timeline-item:not(:last-child)::before {
    top: calc(
      var(--journey-timeline-year-size) +
      var(--journey-timeline-gap) +
      (var(--journey-timeline-dot-size) / 2)
    );
    height: 1px;
    background: var(--surface-panel-border);
  }

  .about-journey-section__timeline-item:not(:last-child)::after {
    top: calc(
      var(--journey-timeline-year-size) +
      var(--journey-timeline-gap) +
      (var(--journey-timeline-dot-size) / 2) - 0.25px
    );
    height: 1.5px;
    background: var(--brand-primary);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0.95;
    will-change: transform;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-journey-section__timeline-item.is-complete:not(:last-child)::after {
    transform: scaleX(1);
  }

  .about-journey-section__timeline-button {
    position: relative;
    width: 100%;
    display: grid;
    gap: var(--journey-timeline-gap);
    justify-items: center;
    text-align: center;
    padding: 0;
    color: var(--text-dim-38);
    transition: color var(--transition);
    z-index: 1;
  }

  .about-journey-section__timeline-button:hover {
    color: var(--text-dim-72);
  }

  .about-journey-section__timeline-button.is-active {
    color: var(--bg-dark);
  }

  .about-journey-section__timeline-item.is-complete .about-journey-section__timeline-button {
    color: var(--bg-dark);
  }

  .about-journey-section__timeline-dot {
    position: relative;
    width: var(--journey-timeline-dot-size);
    height: var(--journey-timeline-dot-size);
    border-radius: 999px;
    background: var(--surface-base);
    border: 2px solid var(--surface-field-border);
    z-index: 1;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }

  .about-journey-section__timeline-item.is-complete .about-journey-section__timeline-dot {
    background: var(--brand-primary);
    border-color: var(--brand-primary);
  }

  .about-journey-section__timeline-button.is-active .about-journey-section__timeline-dot {
    background: var(--brand-primary);
    border-color: var(--brand-primary);
    transform: scale(1.08);
  }

  .about-journey-section__timeline-year {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--journey-timeline-year-size);
    font-weight: var(--fw-headline);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .about-journey-section__panel {
    position: relative;
    margin-top: var(--journey-gap-timeline-to-panel);
    min-height: 7rem;
    width: 100%;
    max-width: none;
  }

  .about-journey-section__card {
    position: absolute;
    inset: 0;
    display: grid;
    gap: 0;
    align-content: start;
    padding: 0;
    background: transparent;
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 360ms ease,
      transform 360ms ease;
  }

  .about-journey-section__card.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .about-journey-section__card-description {
    width: 100%;
    max-width: 40rem;
    color: var(--bg-dark);
    line-height: 1.5;
  }

  .about-journey-section__mobile {
    display: none;
  }

  .about-journey-section__mobile-list {
    display: grid;
    gap: 20px;
  }

  .about-journey-section__card--static {
    position: static;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    padding-top: 0;
  }

  @media (max-width: 1024px) {
    .about-journey-section__panel {
      min-height: 8rem;
    }

    .about-journey-section__timeline {
      gap: 12px;
    }
  }

  @media (max-width: 900px) {
    .about-journey-section__desktop {
      display: none;
    }

    .about-journey-section__mobile {
      display: grid;
      gap: 32px;
    }

    .about-journey-section__intro-text {
      max-width: none;
    }

    .about-journey-section__card-description {
      max-width: none;
    }
  }
</style>

