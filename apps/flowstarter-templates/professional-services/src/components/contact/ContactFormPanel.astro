---
import type { CountryCodeOption } from '../../lib/contact-country-codes';
import TextAreaField from '../form/TextAreaField.astro';
import TextField from '../form/TextField.astro';
import PhoneField from '../form/PhoneField.astro';

interface Props {
  form: {
    title: string;
    note: string;
    fullNameLabel: string;
    fullNamePlaceholder: string;
    emailLabel: string;
    emailPlaceholder: string;
    phoneLabel: string;
    phonePlaceholder: string;
    messageLabel: string;
    messagePlaceholder: string;
    submitLabel: string;
    successMessage: string;
    sentMessage: string;
    failureMessage: string;
  };
  countryCodes: CountryCodeOption[];
  defaultCountry: CountryCodeOption;
  contactEmail?: string;
}

const { form, countryCodes, defaultCountry, contactEmail } = Astro.props;

/*
  The no-JavaScript path. A form with nothing but a submit button is a form
  that loses the message, so the action is a real mailto: with no script in
  front of it. The lead capture script the platform injects intercepts submit
  before this ever fires, and falls back to it when the network is gone.
*/
const mailtoAction = contactEmail ? `mailto:${contactEmail}` : undefined;
---

<div class="contact-form-panel">
  <form
    class="contact-form-panel__form"
    data-contact-form
    data-contact-email={contactEmail}
    action={mailtoAction}
    method="post"
    enctype="text/plain"
    novalidate
  >
    <TextField label={form.fullNameLabel} name="fullName" placeholder={form.fullNamePlaceholder} required={true} />
    <TextField label={form.emailLabel} name="email" type="email" placeholder={form.emailPlaceholder} required={true} />

    <PhoneField
      label={form.phoneLabel}
      codeName="countryCode"
      phoneName="phone"
      phonePlaceholder={form.phonePlaceholder}
      required={true}
      options={countryCodes}
      defaultOption={defaultCountry}
    />

    <TextAreaField label={form.messageLabel} name="message" placeholder={form.messagePlaceholder} required={true} rows={7} />

    <!--
      Nobody sees this and nobody fills it in. A submission that carries it is
      accepted with the same answer as any other and then dropped, because
      telling a bot it was caught is telling it what to change next time.
    -->
    <p class="contact-form-panel__trap" aria-hidden="true">
      <label>
        Company website
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="contact-form-panel__footer">
      <button type="submit" class="contact-form-panel__submit">{form.submitLabel}</button>
      <p class="contact-form-panel__note">{form.note}</p>
      <p class="contact-form-panel__success" data-contact-success hidden>{form.successMessage}</p>
      <p class="contact-form-panel__success" data-contact-sent hidden>{form.sentMessage}</p>
      <p class="contact-form-panel__failure" data-contact-error hidden>{form.failureMessage}</p>
    </div>
  </form>
</div>

<style>
  .contact-form-panel {
    --panel-gap: 32px;
    --form-gap: 22px;
    --phone-gap: 18px;
    --field-height: 58px;
    --form-field-gap: 10px;
    display: grid;
    gap: var(--panel-gap);
  }

  .contact-form-panel__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .contact-form-panel__title {
    text-transform: uppercase;
    color: var(--bg-dark);
  }

  .contact-form-panel__note {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--text-muted);
  }

  .contact-form-panel__form {
    display: grid;
    gap: var(--form-gap);
  }

.contact-form-panel__footer {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .contact-form-panel__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--field-height);
    padding: 0 30px;
    border: 2px solid var(--bg-dark);
    background: var(--bg-dark);
    color: var(--text-on-dark);
    font-family: var(--font-button);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: transform var(--transition), opacity var(--transition);
  }

  .contact-form-panel__submit:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .contact-form-panel__success {
    color: var(--bg-dark);
    line-height: 1.5;
    max-width: 520px;
  }

  .contact-form-panel__failure {
    color: var(--bg-dark);
    line-height: 1.5;
    max-width: 520px;
    font-weight: var(--fw-semibold);
  }

  /* Off screen rather than display:none, which some bots skip. */
  .contact-form-panel__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .contact-form-panel__header {
      align-items: start;
      flex-direction: column;
    }

    .contact-form-panel__note {
      text-align: left;
    }

    .contact-form-panel__phone-row {
      grid-template-columns: 1fr;
    }
  }
</style>
