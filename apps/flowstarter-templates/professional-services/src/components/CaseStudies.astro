---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import CaseStudyCard from './design-system/CaseStudyCard.astro';
import ActionButton from './design-system/ActionButton.astro';

const { caseStudies } = siteLabels;
interface Props {
  showCta?: boolean;
  ctaHref?: string;
  layout?: 'masonry' | 'list';
}

const {
  showCta = true,
  ctaHref = '/work',
  layout = 'masonry',
} = Astro.props;

const leftProjects = caseStudies.projects.filter((_, index) => index % 2 === 0);
const rightProjects = caseStudies.projects.filter((_, index) => index % 2 === 1);
---

<SectionBlock id="case-studies" className="case-studies">
  <div class="case-studies__inner container">

    {layout === 'masonry' && (
      <>
        <div class="case-studies__intro" data-case-reveal style="--reveal-delay: 100ms">
          <h2 class="case-studies__title">{caseStudies.sectionTitle}</h2>
          <p class="case-studies__description">{caseStudies.sectionDescription}</p>
        </div>
        <div class="case-studies__masonry">
          <div class="case-studies__column case-studies__column--left">
            {leftProjects.map((project, index) => (
              <div data-case-reveal style={`--reveal-delay: ${index * 80}ms`}>
                <CaseStudyCard
                  title={project.title}
                  category={project.category}
                  color={project.color}
                  imageSrc={project.imageSrc}
                  imageScale={project.imageScale}
                  href={project.href}
                  className="case-studies__card case-studies__card--left"
                />
              </div>
            ))}
          </div>
          <div class="case-studies__column case-studies__column--right">
            {rightProjects.map((project, index) => (
              <div data-case-reveal style={`--reveal-delay: ${120 + index * 80}ms`}>
                <CaseStudyCard
                  title={project.title}
                  category={project.category}
                  color={project.color}
                  imageSrc={project.imageSrc}
                  imageScale={project.imageScale}
                  href={project.href}
                  className={`case-studies__card case-studies__card--right case-studies__card--right-${index + 1}`}
                />
              </div>
            ))}
          </div>
        </div>
      </>
    )}

    {layout === 'list' && (
      <div class="case-studies__list">
        {caseStudies.projects.map((project, index) => (
          <article class="case-studies__list-item" data-case-reveal style={`--reveal-delay: ${index * 60}ms`}>
            <a href={project.href} class="case-studies__list-image">
              {project.imageSrc
                ? <img src={project.imageSrc} alt={project.title} loading="lazy" style={project.imageScale ? `transform: scale(${project.imageScale})` : undefined} />
                : (
                  // No screenshot for this engagement — a typographic tile
                  // (its own name and category) rather than the template's
                  // stock or abstract art standing in for work never done.
                  <div class="case-studies__list-image-fallback" style={`background-color: ${project.color}`}>
                    <span class="case-studies__list-image-fallback-title">{project.title}</span>
                    <span class="case-studies__list-image-fallback-category">{project.category}</span>
                  </div>
                )
              }
            </a>
            <div class="case-studies__list-content">
              <span class="case-studies__list-category">{project.category}</span>
              <h2 class="case-studies__list-title">
                <a href={project.href} class="case-studies__list-title-link">{project.title}</a>
              </h2>
              <p class="case-studies__list-description">{project.description}</p>
              <ActionButton
                href={project.href}
                label="View engagement"
                variant="outline"
                className="case-studies__list-btn ds-action-button--outline-dark"
              />
            </div>
          </article>
        ))}
      </div>
    )}

    {showCta && (
      <div class="case-studies__cta">
        <ActionButton
          href={ctaHref}
          label="See all engagements"
          variant="outline"
          className="case-studies__cta-button ds-action-button--outline-dark ds-action-button--outline-thick"
        />
      </div>
    )}
  </div>
</SectionBlock>

<style>
  .case-studies__masonry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .case-studies__column {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .case-studies__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .case-studies__intro {
    max-width: 470px;
    margin: 0 auto;
    text-align: center;
  }

  .case-studies__title {
    color: var(--bg-dark);
    margin-bottom: 12px;
  }

  .case-studies__description {
    line-height: 1.45;
    color: var(--bg-dark);
  }

  .case-studies__column :global(.case-studies__card) {
    border-radius: 0;
  }

  .case-studies__column :global(.case-studies__card .ds-case-card__image) {
    aspect-ratio: 161 / 140;
  }

  .case-studies__column :global(.case-studies__card--right-1 .ds-case-card__image) {
    aspect-ratio: 161 / 140;
  }

  .case-studies__column :global(.case-studies__card--right-2 .ds-case-card__image) {
    aspect-ratio: 161 / 140;
  }

  .case-studies__column :global(.case-studies__card--right-3 .ds-case-card__image) {
    aspect-ratio: 161 / 140;
  }

  .case-studies__cta {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 50px;
  }

  .case-studies__cta :global(.case-studies__cta-button) {
    padding: 22px 56px;
    min-width: 320px;
    font-size: 1.2rem;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .case-studies__column {
      gap: 24px;
    }

    .case-studies__intro {
      margin-bottom: 4px;
    }
  }

  @media (max-width: 768px) {
    .case-studies__masonry {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .case-studies__intro {
      text-align: center;
      max-width: 100%;
    }

    .case-studies__cta {
      margin-top: 36px;
    }
  }

  /* Reveal animation */
  :global([data-case-reveal].is-observing:not(.is-visible)) {
    opacity: 0;
    transform: translateY(48px) scale(0.985);
    filter: blur(8px);
  }

  :global([data-case-reveal].is-observing) {
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  :global([data-case-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-case-reveal].is-observing) {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  /* ── List layout (work page) ── */
  .case-studies__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .case-studies__list-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 72px 0;
    border-bottom: 1px solid var(--surface-panel-border);
  }


  .case-studies__list-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface-field);
  }

  .case-studies__list-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform-origin: center;
    transition: transform 600ms ease;
  }

  .case-studies__list-item:hover .case-studies__list-image img {
    transform: scale(1.04);
  }

  .case-studies__list-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 24px;
  }

  .case-studies__list-image-fallback-title {
    font-family: var(--font-title);
    font-size: var(--fs-h4, 1.25rem);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    color: var(--text-on-dark, #fff);
  }

  .case-studies__list-image-fallback-category {
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-dark, #fff);
    opacity: 0.72;
  }

  .case-studies__list-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .case-studies__list-category {
    font-family: var(--font-title);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-primary);
  }

  .case-studies__list-title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-headline);
    text-transform: uppercase;
    color: var(--bg-dark);
    line-height: 1.05;
    margin: 0;
  }

  .case-studies__list-title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: text-decoration-color var(--transition);
  }

  .case-studies__list-title-link:hover {
    text-decoration-color: var(--bg-dark);
  }

  .case-studies__list-description {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--bg-dark);
    max-width: 38rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .case-studies__list-item {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 48px 0;
    }

    .case-studies__list-title {
      font-size: var(--fs-h3);
    }
  }
</style>

<script>
  import { useVisibilityClass } from '../scripts/hooks/useVisibilityClass.js';
  useVisibilityClass({
    selector: '[data-case-reveal]',
    threshold: 0.05,
    rootMargin: '0px',
    once: true,
    revealIfAlreadyVisible: false,
  });
</script>
