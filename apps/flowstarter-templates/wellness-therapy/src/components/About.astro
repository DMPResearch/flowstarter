---
import { frontmatter as siteLabels } from '../content/site-labels.md';
import SectionBlock from './design-system/SectionBlock.astro';
import SectionHeading from './design-system/SectionHeading.astro';
import VennStatement from './design-system/VennStatement.astro';

const { about } = siteLabels;
---

<SectionBlock id="about" className="about" tone="dark">
  <div class="about__inner container" data-about-stage>
    <SectionHeading
      className="about__header"
      label={about.sectionLabel}
      title={about.title}
      align="center"
      maxWidth="700px"
      labelColor="var(--text-on-dark)"
    />
    <VennStatement circles={about.circles} />
    <p class="about__text">{about.text}</p>
  </div>
</SectionBlock>

<style>
  :global(.about) {
    overflow: clip;
  }

  .about__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 36px;
    padding-bottom: 36px;
  }

  :global(.about__header) {
    margin-bottom: 64px;
  }

  .about__text {
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    max-width: 620px;
    margin: 56px auto 0;
    line-height: 1.7;
    color: var(--text-on-dark);
  }

  @media (max-width: 768px) {
    :global(.about__header) {
      margin-bottom: 40px;
    }

    .about__text {
      margin-top: 40px;
    }
  }
</style>

