---
import { sanitizeRichText } from '../../lib/sanitize-html';

interface Props {
  label?: string;
  title?: string;
  titleLines?: string[];
  align?: 'left' | 'center';
  className?: string;
  labelClassName?: string;
  titleClassName?: string;
  maxWidth?: string;
  labelColor?: string;
  titleColor?: string;
}

const {
  label,
  title,
  titleLines,
  align = 'left',
  className = '',
  labelClassName = '',
  titleClassName = '',
  maxWidth,
  labelColor,
  titleColor,
} = Astro.props;

// `set:html` below is a raw-HTML sink and these strings come from
// `src/content/*.md`, which an agent writes from an untrusted brief. The
// loader in `src/lib/site-data.ts` already sanitises them; doing it again
// here is deliberate, because this component can also be handed a literal
// by a page the agent wrote itself.
const resolvedTitle = sanitizeRichText(
  titleLines?.join('<br />') ?? title ?? '',
);
const titleStyle = [maxWidth ? `max-width:${maxWidth};` : '', titleColor ? `color:${titleColor};` : '']
  .join(' ')
  .trim() || undefined;
const labelStyle = labelColor ? `color:${labelColor};` : undefined;
---

<div class={`ds-section-heading ds-section-heading--${align} ${className}`.trim()}>
  {label && <p class={`section-label ${labelClassName}`.trim()} style={labelStyle}>{label}</p>}
  {resolvedTitle && <h2 class={`section-title ${titleClassName}`.trim()} style={titleStyle} set:html={resolvedTitle} />}
</div>

<style>
  .ds-section-heading--center {
    text-align: center;
  }

  .ds-section-heading--center .section-title {
    margin-left: auto;
    margin-right: auto;
  }
</style>
