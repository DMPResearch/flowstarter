---
import { sanitizeInlineSvg } from '../../lib/sanitize-html';

interface Props {
  icon: string;
  title: string;
  description: string;
  className?: string;
  style?: string;
}

const { icon, title, description, className = '', style = '' } = Astro.props;
---

<div
  class={`ds-service-card ${className}`.trim()}
  data-service-card
  style={`--service-hover-y: 0px; ${style}`.trim()}
>
  <div class="ds-service-card__icon" set:html={sanitizeInlineSvg(icon)} />
  <h4 class="ds-service-card__title">{title}</h4>
  <p class="ds-service-card__desc">{description}</p>
</div>

<style>
  .ds-service-card {
    --service-card-index: 0;
    position: relative;
    overflow: hidden;
    padding: 36px 28px;
    border: 1px solid var(--surface-subtle-border);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
    transition:
      box-shadow var(--transition),
      border-color var(--transition),
      background-color var(--transition);
  }

  /* Calm reveal: cards settle in on load with a soft stagger.
     Only opacity is animated so hover/interaction stays clean. */
  html.js .ds-service-card {
    opacity: 0;
    clip-path: inset(18px 0 0 0 round var(--radius-lg));
    animation: ds-service-enter 760ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--service-card-index) * 80ms + 120ms);
  }

  @keyframes ds-service-enter {
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0 round var(--radius-lg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .ds-service-card {
      opacity: 1;
      clip-path: none;
      animation: none;
    }
  }

  .ds-service-card:hover {
    box-shadow: var(--shadow-float);
    border-color: transparent;
    background: var(--brand-primary);
  }

  .ds-service-card__icon {
    position: relative;
    z-index: 1;
    color: var(--bg-dark);
    margin-bottom: 20px;
    transition: transform 0.35s ease, color 0.35s ease;
  }

  .ds-service-card__title {
    position: relative;
    z-index: 1;
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    color: var(--bg-dark);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    transition: transform 0.35s ease, letter-spacing 0.35s ease;
  }

  .ds-service-card__desc {
    position: relative;
    z-index: 1;
    font-size: var(--fs-body);
    line-height: 1.6;
    transition: transform 0.35s ease;
  }

  .ds-service-card:hover .ds-service-card__icon {
    transform: translateY(-4px) rotate(-6deg) scale(1.04);
    color: var(--text-on-dark);
  }

  .ds-service-card:hover .ds-service-card__title,
  .ds-service-card:hover .ds-service-card__desc {
    color: var(--text-on-dark);
  }

  .ds-service-card:hover .ds-service-card__title {
    transform: translateX(6px);
    letter-spacing: 0.9px;
  }

  .ds-service-card:hover .ds-service-card__desc {
    transform: translateX(6px);
  }
</style>
