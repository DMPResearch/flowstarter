{
  "name": "@flowstarter/build-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Private Pi build worker: drains the FULL_SITE_BUILD job ledger into FullSiteBuildWorker (worktree -> Pi full-site agent -> validate -> commit -> PR).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "FLOWSTARTER_BUILD_MODE=local FLOWSTARTER_BUILD_STUB_AGENT=true tsx watch --env-file-if-exists=../flowstarter-main/.env.local --env-file-if-exists=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flowstarter/agentic-codegen": "workspace:*",
    "@flowstarter/platform-config": "workspace:*",
    "@supabase/supabase-js": "2.95.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
