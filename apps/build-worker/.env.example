# Flowstarter build worker — runs on the Hetzner compute host, never on Netlify.
# Every secret here is server-side only. Never prefix any of them NEXT_PUBLIC_.

# --- Dispatch auth (must match flowstarter-main's FLOWSTARTER_BUILD_WORKER_SECRET) ---
FLOWSTARTER_BUILD_WORKER_SECRET=replace-with-at-least-32-random-characters
FLOWSTARTER_BUILD_WORKER_PORT=8787
FLOWSTARTER_BUILD_WORKER_HOST=0.0.0.0

# --- Durable state: the job ledger and artifact tables are service-role only ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Pi full-site coding session ---
PI_PROVIDER=openrouter
PI_MODEL=your-approved-model-id
PI_API_KEY=your-provider-api-key
PI_THINKING_LEVEL=medium
PI_TIMEOUT_MS=1800000

# --- Publish mode: "github" (production) or "local" (dev/dry) ---
# github: push the client branch and open the internal draft PR that gates
#         HUMAN_QA. Requires FLOWSTARTER_SITES_* below.
# local:  package the built site, serve the tarball off this worker, and ask
#         flowstarter-main to deploy it via the ordinary deploySite path.
#         Requires none of the GitHub variables and no Hetzner host.
FLOWSTARTER_BUILD_MODE=github

# --- Isolated git worktrees for client builds ---
# In local mode these default to /tmp/flowstarter-local/* and the repository is
# `git init`-ed on first boot.
FLOWSTARTER_REPOSITORY_ROOT=/srv/flowstarter/repository
FLOWSTARTER_WORKTREES_ROOT=/srv/flowstarter/worktrees
FLOWSTARTER_SITES_BASE_REF=main
FLOWSTARTER_SITES_REMOTE=origin

# --- Internal review PR that gates HUMAN_QA (github mode only) ---
FLOWSTARTER_SITES_REPO=flowstarter/sites
FLOWSTARTER_SITES_GITHUB_TOKEN=token-with-contents-and-pull-requests-write

# FLOWSTARTER_STAGING_URL_TEMPLATE is optional. It defaults from
# @flowstarter/platform-config's resolvePlatformDomain(), keyed off
# FLOWSTARTER_ENV (or NODE_ENV when that is unset): development, test and
# staging default to https://{projectId}.staging.flowstarter.dev; only
# production defaults to https://{projectId}.staging.flowstarter.net. Set it
# explicitly only to override that.
# FLOWSTARTER_STAGING_URL_TEMPLATE=https://{projectId}.staging.flowstarter.dev

# --- Local mode: package + deploy instead of opening a PR -------------------
# Where packaged tarballs are written, and the base URL the deploy-agent pulls
# them from. Defaults to this worker's own http://127.0.0.1:<port>.
# FLOWSTARTER_BUILD_ARTIFACTS_ROOT=/tmp/flowstarter-build-artifacts
# FLOWSTARTER_BUILD_ARTIFACT_BASE_URL=http://127.0.0.1:8787
# flowstarter-main, which owns deploySite and the deployments ledger.
# FLOWSTARTER_MAIN_URL=http://127.0.0.1:3000
# Directory inside the built site to package; falls back to the site root.
# FLOWSTARTER_BUILD_OUTPUT_DIR=dist
# Replaces ONLY the Pi coding session with a deterministic pass (local mode
# only) -- the SITE_REBUILD/CHANGE_REQUEST_BUILD/FULL_SITE_BUILD job it drives
# still runs the real trusted validator below. Use this when there is no
# model key or no budget; it is never a way to skip the build gate too.
# FLOWSTARTER_BUILD_STUB_AGENT=false

# --- Trusted validation, run outside Pi. JSON array of argv arrays. ---
# FLOWSTARTER_BUILD_VALIDATE_COMMANDS=[["pnpm","install","--ignore-scripts","--prefer-offline"],["pnpm","run","build"]]
FLOWSTARTER_BUILD_TIMEOUT_MS=900000

# Swaps the real validator above for a noop that always passes, for EVERY
# job kind. This is the only variable that may do that -- FLOWSTARTER_BUILD_
# STUB_AGENT never does. Unit-test-only: refused at boot when the resolved
# environment (FLOWSTARTER_ENV, falling back to NODE_ENV) is staging or
# production, so a client build can never silently skip
# `pnpm install && pnpm run build` and ship an unbuilt source tree.
# FLOWSTARTER_BUILD_SKIP_VALIDATION=false

# --- Queue sizing and retry budget ---
FLOWSTARTER_BUILD_MAX_ATTEMPTS=3
FLOWSTARTER_BUILD_CONCURRENCY=1
FLOWSTARTER_BUILD_QUEUE_LIMIT=32
