# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
bun.lock
/.sass-cache
/connect.lock
/coverage
/\.local
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Private keys / keystores (never commit)
*.pem
*.p12
*.pfx

.nx/cache
.nx/workspace-data
mprocs.log

# Environment files — NEVER commit secrets
# Ignore all .env files across the entire monorepo
.env
.env.*
!.env.example
!.env.*.example
!.env.shared.example
!.env.test.example

# Cloudflare Wrangler — local-only secrets for `wrangler dev`
**/.dev.vars

# E2E auth session data (contains tokens/cookies)
**/.auth/

# Playwright MCP / local agent logs
.playwright-mcp/

# Claude Code — machine-local overrides (paths, permissions)
**/.claude/settings.local.json

# M4 sync scripts
m4-sync.sh
m4-pull.sh
m4-dev.sh

# Test artifacts & screenshots
e2e/screenshots/
playwright-report/
test-results/
# The daily QA lane's JSON report (.depot/workflows/daily-qa.yml uploads it as
# a run artifact; it is never committed).
qa-journeys-report.json

# Visual check — only the linux/ baselines are committed (CI runs on
# ubuntu-latest). macOS baselines render fonts/AA differently and would
# never match the Linux ones, so darwin/ stays local-only.
# See e2e/visual/README.md.
e2e/visual/__screenshots__/darwin/

# Dev screenshots / artifacts
docs/screenshots/

# Next.js build output
.next/

# Astro template build output — regenerated by Netlify before `next build`.
# `apps/flowstarter-main/public/preview/<slug>/` is the live iframe target
# for the 5 Dorin templates and is gitignored to keep the repo small.
apps/flowstarter-main/public/preview/

# Astro internal cache + per-template generated env types
**/.astro/
apps/flowstarter-library/templates/*/src/env.d.ts
apps/flowstarter-library/templates/*/package-lock.json

# Coverage reports (nested)
**/coverage/

# Local Netlify folder
.netlify

# Local WIP archives — kept out of the repo so they can't break CI
.archive-wip-*/

.demo-screenshots/

# Generated demo artifacts (rebuildable from the pipeline)
artifacts/darius-portfolio/
workflow-showcase-static/
artifacts/showcase/

# Design-bundle phone screenshots: reference material, 27 MB, nothing in the repo reads them.
flowstarter/project/uploads/

# Route coverage records when a job runs Playwright more than once and needs
# them to survive Playwright emptying test-results (see e2e/support/coverage-fixture.ts).
/route-coverage

# Playwright JSON reports the release lane writes and uploads as artifacts.
/release-results

# The machine-readable half of the readiness scorecard, regenerated on every
# run and carrying a timestamp. readiness/README.md is the committed half.
/readiness/summary.json
