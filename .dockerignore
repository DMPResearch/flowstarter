apps/flowstarter-editor
# The library workspace is excluded except for the two pieces the `previews`
# stage of deploy/hetzner-staging/Dockerfile needs: its package.json, so
# `pnpm install --filter @flowstarter/library` can resolve astro, and the Astro
# templates it builds. reference/, showcase/ and mcp-server/ stay out.
apps/flowstarter-library/**
!apps/flowstarter-library/package.json
!apps/flowstarter-library/templates/**
apps/flowstarter-library/templates/**/node_modules/**
apps/flowstarter-library/templates/**/.astro/**
apps/flowstarter-library/templates/**/dist/**
# Excluded except for the four templates the `templates` stage of
# deploy/hetzner-staging/Dockerfile installs and ships for the discovery
# funnel's preview build (static-preview-build.ts): creative-portfolio,
# local-trade, professional-services, wellness-therapy. dorin-portfolio
# (legacy) and demo-coach (editor dev fixture) stay out — neither is a
# template a generated site can be built from, see TEMPLATE_CATALOG in
# packages/agentic-codegen/src/workspace.ts.
apps/flowstarter-templates/**
!apps/flowstarter-templates/creative-portfolio/**
!apps/flowstarter-templates/local-trade/**
!apps/flowstarter-templates/professional-services/**
!apps/flowstarter-templates/wellness-therapy/**
apps/flowstarter-templates/*/node_modules/**
apps/flowstarter-templates/*/.astro/**
apps/flowstarter-templates/*/dist/**
apps/flowstarter-selfserve
apps/shopify-landing
apps/deploy-agent
