# ============================================
# SHARED ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================
# Copy this to .env.shared and fill in real values.
# These variables are shared across all apps in the monorepo.
# ============================================

# --------------------------------------------
# CLERK AUTHENTICATION
# --------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Cookie domain for cross-subdomain auth. Follows the same env-driven rule as
# @flowstarter/platform-config's resolvePlatformDomain(): development, test
# and staging use .flowstarter.dev, production uses .flowstarter.net. Leave
# unset locally (no cross-subdomain cookie needed on localhost).
# CLERK_COOKIE_DOMAIN=.flowstarter.net

# --------------------------------------------
# SUPABASE
# --------------------------------------------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# --------------------------------------------
# INTER-APP COMMUNICATION
# --------------------------------------------
SHARED_APP_SECRET=your-secret-here

# --------------------------------------------
# PLATFORM URLs
# --------------------------------------------
MAIN_PLATFORM_URL=http://localhost:3000
EDITOR_URL=http://localhost:5175
